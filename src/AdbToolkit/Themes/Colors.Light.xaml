<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== 浅色主题调色板（Material Light 风格） ===== -->

    <!-- 背景 -->
    <SolidColorBrush x:Key="Bg.Window"   Color="#F5F6F8"/>
    <SolidColorBrush x:Key="Bg.Sidebar"  Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Bg.Card"     Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Bg.Hover"    Color="#EEF2F7"/>
    <SolidColorBrush x:Key="Bg.Active"   Color="#E3EDFC"/>
    <SolidColorBrush x:Key="Bg.Sunken"   Color="#F8F9FB"/>
    <SolidColorBrush x:Key="Bg.Input"    Color="#FFFFFF"/>

    <!-- 主题色 -->
    <SolidColorBrush x:Key="Accent"         Color="#409EFF"/>
    <SolidColorBrush x:Key="Accent.Hover"   Color="#66B1FF"/>
    <SolidColorBrush x:Key="Accent.Pressed" Color="#2F8BE6"/>
    <SolidColorBrush x:Key="Accent.Pale"    Color="#DDEEFE"/>

    <!-- 文字 -->
    <SolidColorBrush x:Key="Text.Primary"   Color="#1F2328"/>
    <SolidColorBrush x:Key="Text.Secondary" Color="#5F6B7A"/>
    <SolidColorBrush x:Key="Text.Disabled"  Color="#9AA4B2"/>

    <!-- 边框 -->
    <SolidColorBrush x:Key="Border"  Color="#DFE3E8"/>
    <SolidColorBrush x:Key="Divider" Color="#E9ECF0"/>

    <!-- 状态色 -->
    <SolidColorBrush x:Key="Status.OK"    Color="#188038"/>
    <SolidColorBrush x:Key="Status.Warn"  Color="#B26A00"/>
    <SolidColorBrush x:Key="Status.Error" Color="#D93025"/>
    <SolidColorBrush x:Key="Danger.Border" Color="#F3C2BD"/>

    <!-- Logcat 级别色 -->
    <SolidColorBrush x:Key="Log.V" Color="#9AA4B2"/>
    <SolidColorBrush x:Key="Log.D" Color="#188038"/>
    <SolidColorBrush x:Key="Log.I" Color="#409EFF"/>
    <SolidColorBrush x:Key="Log.W" Color="#B26A00"/>
    <SolidColorBrush x:Key="Log.E" Color="#D93025"/>
    <SolidColorBrush x:Key="Log.F" Color="#7A0C0C"/>

</ResourceDictionary>
