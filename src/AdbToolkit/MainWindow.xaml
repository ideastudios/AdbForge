<Window x:Class="AdbToolkit.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:AdbToolkit.Resources"
        Title="{x:Static res:Strings.App_Title}"
        Icon="pack://application:,,,/assets/app.ico"
        Width="1240" Height="780"
        MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg.Window}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ======= 顶部全局设备栏 ======= -->
        <Border Grid.Row="0"
                Background="{StaticResource Bg.Card}"
                BorderBrush="{StaticResource Divider}"
                BorderThickness="0,0,0,1"
                Padding="14,8">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Ellipse Width="9" Height="9"
                             VerticalAlignment="Center"
                             Margin="0,0,10,0"
                             Fill="{Binding AdbStatusBrush}"/>
                    <ComboBox ItemsSource="{Binding Devices}"
                              SelectedItem="{Binding SelectedDevice}"
                              DisplayMemberPath="DisplayName"
                              Width="270" VerticalContentAlignment="Center"/>
                    <Button Content="{x:Static res:Strings.Common_Refresh}" Margin="10,0,0,0"
                            Style="{StaticResource BtnTool}"
                            Command="{Binding RefreshDevicesCommand}"/>

                    <!-- 前台应用指示器：点击复制组件名 -->
                    <Border Background="{StaticResource Bg.Sunken}"
                            BorderBrush="{StaticResource Divider}"
                            BorderThickness="1"
                            CornerRadius="4" Padding="10,4" Margin="14,0,0,0"
                            VerticalAlignment="Center"
                            Cursor="Hand"
                            ToolTip="{x:Static res:Strings.Main_ForegroundTooltip}">
                        <Border.InputBindings>
                            <MouseBinding Gesture="LeftClick" Command="{Binding CopyForegroundCommand}"/>
                        </Border.InputBindings>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{x:Static res:Strings.Main_ForegroundLabel}" FontSize="11.5"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource Text.Secondary}"/>
                            <TextBlock Text="{Binding ForegroundText}" FontSize="11.5"
                                       FontFamily="Consolas"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource Accent}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Image Source="/assets/logo.png"
                           Width="22" Height="22"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="{x:Static res:Strings.App_Title}"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0"
                               FontWeight="Bold"
                               Foreground="{StaticResource Accent}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ======= 主体：侧边栏 + 内容区 ======= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <!-- 侧边栏 -->
            <Border Grid.Column="0"
                    Background="{StaticResource Bg.Sidebar}"
                    BorderBrush="{StaticResource Divider}"
                    BorderThickness="0,0,1,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="16,14,0,6">
                        <TextBlock Text="{x:Static res:Strings.Main_SidebarTitle}" FontSize="15" FontWeight="Bold"/>
                        <TextBlock Text="{x:Static res:Strings.Main_SidebarSubtitle}" FontSize="11"
                                   Foreground="{StaticResource Text.Secondary}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <ListBox ItemsSource="{Binding NavItems}"
                             SelectedItem="{Binding SelectedNav}"
                             Style="{StaticResource NavListBox}"
                             Margin="0,8,0,0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                                               Text="{Binding Glyph}"
                                               FontSize="15"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0"/>
                                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- 内容区 -->
            <ContentControl Grid.Column="1"
                            Content="{Binding CurrentView}"
                            Margin="16,14"/>
        </Grid>

        <!-- ======= 底部状态栏 ======= -->
        <Border Grid.Row="2"
                Background="{StaticResource Bg.Card}"
                BorderBrush="{StaticResource Divider}"
                BorderThickness="0,1,0,0"
                Padding="14,5">
            <TextBlock Text="{Binding StatusText}"
                       FontSize="11.5"
                       Foreground="{StaticResource Text.Secondary}"/>
        </Border>
    </Grid>
</Window>
