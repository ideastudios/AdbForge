<UserControl x:Class="AdbToolkit.Views.PerfView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:AdbToolkit.Resources">

    <!-- 应用级隐式 TextBlock 样式不穿透 UserControl 模板边界，本地补一份保证文字跟随主题 -->
    <UserControl.Resources>
        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ======= 左列 ======= -->
            <StackPanel Grid.Column="0" Margin="0,0,12,0">

                <!-- 设备信息 -->
                <Border Style="{StaticResource Card}" Padding="16">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="{x:Static res:Strings.Common_Refresh}" Style="{StaticResource BtnTool}"
                                    Command="{Binding LoadDeviceInfoCommand}"/>
                            <TextBlock Text="{x:Static res:Strings.Perf_DeviceInfoTitle}" Style="{StaticResource CardTitle}"/>
                        </DockPanel>
                        <TextBox Text="{Binding DeviceInfo, Mode=OneWay}" IsReadOnly="True"
                                 FontFamily="Consolas" FontSize="12"
                                 AcceptsReturn="True" TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto" MinHeight="240"
                                 BorderThickness="0" Background="Transparent"/>
                    </StackPanel>
                </Border>

                <!-- 电量 -->
                <Border Style="{StaticResource Card}" Padding="16" Margin="0,12,0,0">
                    <StackPanel>
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                <Button Content="{x:Static res:Strings.Common_Refresh}" Style="{StaticResource BtnTool}"
                                        Command="{Binding RefreshBatteryCommand}"/>
                                <Button Content="{x:Static res:Strings.Perf_AutoRefresh}" Style="{StaticResource BtnTool}" Margin="6,0,0,0"
                                        Command="{Binding AutoRefreshCommand}"/>
                            </StackPanel>
                            <TextBlock Text="{x:Static res:Strings.Perf_BatteryTitle}" Style="{StaticResource CardTitle}"/>
                        </DockPanel>
                        <TextBox Text="{Binding BatteryText, Mode=OneWay}" IsReadOnly="True"
                                 FontFamily="Consolas" FontSize="12" AcceptsReturn="True"
                                 TextWrapping="Wrap" MinHeight="66"
                                 BorderThickness="0" Background="Transparent"/>
                        <Separator Background="{StaticResource Divider}" Margin="0,10"/>
                        <WrapPanel VerticalAlignment="Center">
                            <TextBlock Text="{x:Static res:Strings.Perf_VirtualLevel}" VerticalAlignment="Center" FontSize="12" Margin="0,0,6,0"/>
                            <TextBox Text="{Binding VirtualLevel}" Width="45"/>
                            <Button Content="{x:Static res:Strings.Perf_Set}" Style="{StaticResource BtnTool}" Margin="6,0,0,0"
                                    Command="{Binding SetBatteryLevelCommand}"/>
                            <Button Content="{x:Static res:Strings.Perf_Unplug}" Style="{StaticResource BtnTool}" Margin="6,0,0,0"
                                    Command="{Binding BatteryUnplugCommand}"/>
                            <Button Content="{x:Static res:Strings.Perf_Reset}" Style="{StaticResource BtnAccent}" Margin="6,0,0,0"
                                    Command="{Binding BatteryResetCommand}"/>
                        </WrapPanel>
                        <CheckBox Content="{x:Static res:Strings.Perf_AutoRefresh3s}" IsChecked="{Binding AutoRefresh}"
                                  Margin="0,8,0,0" FontSize="11.5"/>
                    </StackPanel>
                </Border>

                <!-- 硬件状态 -->
                <Border Style="{StaticResource Card}" Padding="16" Margin="0,12,0,0">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="{x:Static res:Strings.Common_Refresh}" Style="{StaticResource BtnTool}"
                                    Command="{Binding RefreshHardwareCommand}"/>
                            <TextBlock Text="{x:Static res:Strings.Perf_HardwareTitle}" Style="{StaticResource CardTitle}"/>
                        </DockPanel>
                        <TextBlock Text="{x:Static res:Strings.Perf_CpuFreq}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ItemsControl ItemsSource="{Binding CpuFreqs}" FontSize="11.5"
                                      FontFamily="Consolas" Foreground="{StaticResource Text.Secondary}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Margin="0,1"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{x:Static res:Strings.Perf_GpuFreq}" FontSize="12" FontWeight="SemiBold" Margin="0,10,0,4"/>
                        <ItemsControl ItemsSource="{Binding GpuFreqs}" FontSize="11.5"
                                      FontFamily="Consolas" Foreground="{StaticResource Text.Secondary}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Margin="0,1"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{x:Static res:Strings.Perf_Thermal}" FontSize="12" FontWeight="SemiBold" Margin="0,10,0,4"/>
                        <ItemsControl ItemsSource="{Binding ThermalZones}" FontSize="11.5"
                                      FontFamily="Consolas" Foreground="{StaticResource Text.Secondary}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Margin="0,1"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ======= 右列 ======= -->
            <StackPanel Grid.Column="1">

                <!-- 应用详情 -->
                <Border Style="{StaticResource Card}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="{x:Static res:Strings.Perf_AppDetailTitle}" Style="{StaticResource CardTitle}"/>
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="8,0,0,0">
                                <Button Content="{x:Static res:Strings.Perf_Fetch}" Style="{StaticResource BtnTool}"
                                        Command="{Binding LoadAppDetailCommand}"/>
                                <Button Content="{x:Static res:Strings.Apps_MenuOpenSystemDetail}" Style="{StaticResource BtnTool}" Margin="6,0,0,0"
                                        Command="{Binding OpenDetailSettingsCommand}"/>
                            </StackPanel>
                            <TextBox Text="{Binding DetailPackage, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="Consolas" VerticalContentAlignment="Center"/>
                        </DockPanel>
                        <TextBox Text="{Binding AppDetailText, Mode=OneWay}" IsReadOnly="True"
                                 FontFamily="Consolas" FontSize="11.5"
                                 AcceptsReturn="True" TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 MinHeight="170" Margin="0,8,0,0"
                                 BorderThickness="0" Background="{StaticResource Bg.Sunken}"/>
                    </StackPanel>
                </Border>

                <!-- 内存 -->
                <Border Style="{StaticResource Card}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="{x:Static res:Strings.Perf_MemTitle}" Style="{StaticResource CardTitle}"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="{x:Static res:Strings.Perf_Fetch}" Style="{StaticResource BtnTool}" Margin="8,0,0,0"
                                    Command="{Binding MemInfoCommand}"/>
                            <TextBox Text="{Binding MemPackage, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="Consolas" VerticalContentAlignment="Center"/>
                        </DockPanel>
                        <TextBox Text="{Binding MemInfoText, Mode=OneWay}" IsReadOnly="True"
                                 FontFamily="Consolas" FontSize="11.5"
                                 AcceptsReturn="True" TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 MinHeight="150" Margin="0,8,0,0"
                                 BorderThickness="0" Background="{StaticResource Bg.Sunken}"/>
                    </StackPanel>
                </Border>

                <!-- 启动时间 -->
                <Border Style="{StaticResource Card}" Padding="16" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="{x:Static res:Strings.Perf_StartupTitle}" Style="{StaticResource CardTitle}"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="{x:Static res:Strings.Perf_StartTest}" Style="{StaticResource BtnTool}" Margin="8,0,0,0"
                                    Command="{Binding StartupTestCommand}"/>
                            <TextBox Text="{Binding StartupComponent, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="Consolas" VerticalContentAlignment="Center"/>
                        </DockPanel>
                        <WrapPanel Margin="0,6,0,0">
                            <TextBlock Text="{x:Static res:Strings.Perf_TestCount}" VerticalAlignment="Center" FontSize="12" Margin="0,0,6,0"/>
                            <TextBox Text="{Binding StartupCount}" Width="50"/>
                        </WrapPanel>
                        <TextBox Text="{Binding StartupResult, Mode=OneWay}" IsReadOnly="True"
                                 FontFamily="Consolas" FontSize="11.5"
                                 AcceptsReturn="True" TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 MinHeight="90" Margin="0,8,0,0"
                                 BorderThickness="0" Background="{StaticResource Bg.Sunken}"/>
                    </StackPanel>
                </Border>

                <!-- 帧率 -->
                <Border Style="{StaticResource Card}" Padding="16" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="{x:Static res:Strings.Perf_GfxTitle}" Style="{StaticResource CardTitle}"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="{x:Static res:Strings.Perf_Fetch}" Style="{StaticResource BtnTool}" Margin="8,0,0,0"
                                    Command="{Binding GfxInfoCommand}"/>
                            <TextBox Text="{Binding GfxPackage, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="Consolas" VerticalContentAlignment="Center"/>
                        </DockPanel>
                        <TextBox Text="{Binding GfxResult, Mode=OneWay}" IsReadOnly="True"
                                 FontFamily="Consolas" FontSize="12" AcceptsReturn="True"
                                 TextWrapping="NoWrap" MinHeight="50" Margin="0,8,0,0"
                                 BorderThickness="0" Background="{StaticResource Bg.Sunken}"/>
                    </StackPanel>
                </Border>

                <!-- 崩溃/ANR 历史 -->
                <Border Style="{StaticResource Card}" Padding="16" Margin="0,12,0,0">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="{x:Static res:Strings.Apps_RefreshList}" Style="{StaticResource BtnTool}"
                                    Command="{Binding RefreshDropBoxCommand}"/>
                            <TextBlock Text="{x:Static res:Strings.Perf_DropBoxTitle}" Style="{StaticResource CardTitle}"/>
                        </DockPanel>
                        <ListBox ItemsSource="{Binding DropBoxEntries}"
                                 SelectedItem="{Binding SelectedDropBox}"
                                 MinHeight="110" FontSize="11.5" FontFamily="Consolas" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Time}" Foreground="{StaticResource Text.Secondary}"
                                                   Margin="0,0,10,0"/>
                                        <TextBlock Text="{Binding Tag}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCrash}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource Status.Error}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsAnr}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource Status.Warn}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Button Content="{x:Static res:Strings.Perf_ViewLatestLog}" Style="{StaticResource BtnTool}" Margin="0,6,0,0"
                                HorizontalAlignment="Left"
                                Command="{Binding ViewDropBoxCommand}"/>
                        <TextBox Text="{Binding DropBoxText, Mode=OneWay}" IsReadOnly="True"
                                 FontFamily="Consolas" FontSize="11"
                                 AcceptsReturn="True" TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 MinHeight="120" Margin="0,6,0,0"
                                 BorderThickness="0" Background="{StaticResource Bg.Sunken}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
