<UserControl x:Class="AdbToolkit.Views.PerfView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ======= 左列 ======= -->
            <StackPanel Grid.Column="0" Margin="0,0,12,0">

                <!-- 设备信息 -->
                <Border Style="{StaticResource Card}" Padding="16">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="刷新" Style="{StaticResource BtnTool}"
                                    Command="{Binding LoadDeviceInfoCommand}"/>
                            <TextBlock Text="设备信息全景" Style="{StaticResource CardTitle}"/>
                        </DockPanel>
                        <TextBox Text="{Binding DeviceInfo, Mode=OneWay}" IsReadOnly="True"
                                 FontFamily="Consolas" FontSize="12"
                                 AcceptsReturn="True" TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto" MinHeight="240"
                                 BorderThickness="0" Background="Transparent"/>
                    </StackPanel>
                </Border>

                <!-- 电量 -->
                <Border Style="{StaticResource Card}" Padding="16" Margin="0,12,0,0">
                    <StackPanel>
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                <Button Content="刷新" Style="{StaticResource BtnTool}"
                                        Command="{Binding RefreshBatteryCommand}"/>
                                <Button Content="自动刷新" Style="{StaticResource BtnTool}" Margin="6,0,0,0"
                                        Command="{Binding AutoRefreshCommand}"/>
                            </StackPanel>
                            <TextBlock Text="电量面板" Style="{StaticResource CardTitle}"/>
                        </DockPanel>
                        <TextBox Text="{Binding BatteryText, Mode=OneWay}" IsReadOnly="True"
                                 FontFamily="Consolas" FontSize="12" AcceptsReturn="True"
                                 TextWrapping="Wrap" MinHeight="66"
                                 BorderThickness="0" Background="Transparent"/>
                        <Separator Background="{StaticResource Divider}" Margin="0,10"/>
                        <WrapPanel VerticalAlignment="Center">
                            <TextBlock Text="模拟电量" VerticalAlignment="Center" FontSize="12" Margin="0,0,6,0"/>
                            <TextBox Text="{Binding VirtualLevel}" Width="45"/>
                            <Button Content="设置" Style="{StaticResource BtnTool}" Margin="6,0,0,0"
                                    Command="{Binding SetBatteryLevelCommand}"/>
                            <Button Content="拔出模拟" Style="{StaticResource BtnTool}" Margin="6,0,0,0"
                                    Command="{Binding BatteryUnplugCommand}"/>
                            <Button Content="恢复真实" Style="{StaticResource BtnAccent}" Margin="6,0,0,0"
                                    Command="{Binding BatteryResetCommand}"/>
                        </WrapPanel>
                        <CheckBox Content="自动刷新（3 秒）" IsChecked="{Binding AutoRefresh}"
                                  Margin="0,8,0,0" FontSize="11.5"/>
                    </StackPanel>
                </Border>

                <!-- 硬件状态 -->
                <Border Style="{StaticResource Card}" Padding="16" Margin="0,12,0,0">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="刷新" Style="{StaticResource BtnTool}"
                                    Command="{Binding RefreshHardwareCommand}"/>
                            <TextBlock Text="硬件状态（CPU/GPU 频率 · 温度）" Style="{StaticResource CardTitle}"/>
                        </DockPanel>
                        <TextBlock Text="CPU 频率" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ItemsControl ItemsSource="{Binding CpuFreqs}" FontSize="11.5"
                                      FontFamily="Consolas" Foreground="{StaticResource Text.Secondary}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Margin="0,1"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="GPU / devfreq" FontSize="12" FontWeight="SemiBold" Margin="0,10,0,4"/>
                        <ItemsControl ItemsSource="{Binding GpuFreqs}" FontSize="11.5"
                                      FontFamily="Consolas" Foreground="{StaticResource Text.Secondary}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Margin="0,1"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="温度（thermal zones）" FontSize="12" FontWeight="SemiBold" Margin="0,10,0,4"/>
                        <ItemsControl ItemsSource="{Binding ThermalZones}" FontSize="11.5"
                                      FontFamily="Consolas" Foreground="{StaticResource Text.Secondary}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Margin="0,1"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ======= 右列 ======= -->
            <StackPanel Grid.Column="1">

                <!-- 应用详情 -->
                <Border Style="{StaticResource Card}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="应用详情" Style="{StaticResource CardTitle}"/>
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="8,0,0,0">
                                <Button Content="获取" Style="{StaticResource BtnTool}"
                                        Command="{Binding LoadAppDetailCommand}"/>
                                <Button Content="打开系统详情页" Style="{StaticResource BtnTool}" Margin="6,0,0,0"
                                        Command="{Binding OpenDetailSettingsCommand}"/>
                            </StackPanel>
                            <TextBox Text="{Binding DetailPackage, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="Consolas" VerticalContentAlignment="Center"/>
                        </DockPanel>
                        <TextBox Text="{Binding AppDetailText, Mode=OneWay}" IsReadOnly="True"
                                 FontFamily="Consolas" FontSize="11.5"
                                 AcceptsReturn="True" TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 MinHeight="170" Margin="0,8,0,0"
                                 BorderThickness="0" Background="{StaticResource Bg.Sunken}"/>
                    </StackPanel>
                </Border>

                <!-- 内存 -->
                <Border Style="{StaticResource Card}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="内存分析" Style="{StaticResource CardTitle}"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="获取" Style="{StaticResource BtnTool}" Margin="8,0,0,0"
                                    Command="{Binding MemInfoCommand}"/>
                            <TextBox Text="{Binding MemPackage, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="Consolas" VerticalContentAlignment="Center"/>
                        </DockPanel>
                        <TextBox Text="{Binding MemInfoText, Mode=OneWay}" IsReadOnly="True"
                                 FontFamily="Consolas" FontSize="11.5"
                                 AcceptsReturn="True" TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 MinHeight="150" Margin="0,8,0,0"
                                 BorderThickness="0" Background="{StaticResource Bg.Sunken}"/>
                    </StackPanel>
                </Border>

                <!-- 启动时间 -->
                <Border Style="{StaticResource Card}" Padding="16" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="启动时间（am start -W）" Style="{StaticResource CardTitle}"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="开始测试" Style="{StaticResource BtnTool}" Margin="8,0,0,0"
                                    Command="{Binding StartupTestCommand}"/>
                            <TextBox Text="{Binding StartupComponent, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="Consolas" VerticalContentAlignment="Center"/>
                        </DockPanel>
                        <WrapPanel Margin="0,6,0,0">
                            <TextBlock Text="测试次数" VerticalAlignment="Center" FontSize="12" Margin="0,0,6,0"/>
                            <TextBox Text="{Binding StartupCount}" Width="50"/>
                        </WrapPanel>
                        <TextBox Text="{Binding StartupResult, Mode=OneWay}" IsReadOnly="True"
                                 FontFamily="Consolas" FontSize="11.5"
                                 AcceptsReturn="True" TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 MinHeight="90" Margin="0,8,0,0"
                                 BorderThickness="0" Background="{StaticResource Bg.Sunken}"/>
                    </StackPanel>
                </Border>

                <!-- 帧率 -->
                <Border Style="{StaticResource Card}" Padding="16" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="卡顿分析（gfxinfo）" Style="{StaticResource CardTitle}"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="获取" Style="{StaticResource BtnTool}" Margin="8,0,0,0"
                                    Command="{Binding GfxInfoCommand}"/>
                            <TextBox Text="{Binding GfxPackage, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="Consolas" VerticalContentAlignment="Center"/>
                        </DockPanel>
                        <TextBox Text="{Binding GfxResult, Mode=OneWay}" IsReadOnly="True"
                                 FontFamily="Consolas" FontSize="12" AcceptsReturn="True"
                                 TextWrapping="NoWrap" MinHeight="50" Margin="0,8,0,0"
                                 BorderThickness="0" Background="{StaticResource Bg.Sunken}"/>
                    </StackPanel>
                </Border>

                <!-- 崩溃/ANR 历史 -->
                <Border Style="{StaticResource Card}" Padding="16" Margin="0,12,0,0">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="刷新列表" Style="{StaticResource BtnTool}"
                                    Command="{Binding RefreshDropBoxCommand}"/>
                            <TextBlock Text="崩溃 / ANR 历史（DropBox）" Style="{StaticResource CardTitle}"/>
                        </DockPanel>
                        <ListBox ItemsSource="{Binding DropBoxEntries}"
                                 SelectedItem="{Binding SelectedDropBox}"
                                 MinHeight="110" FontSize="11.5" FontFamily="Consolas" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Time}" Foreground="{StaticResource Text.Secondary}"
                                                   Margin="0,0,10,0"/>
                                        <TextBlock Text="{Binding Tag}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCrash}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource Status.Error}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsAnr}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource Status.Warn}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Button Content="查看该类型最新日志" Style="{StaticResource BtnTool}" Margin="0,6,0,0"
                                HorizontalAlignment="Left"
                                Command="{Binding ViewDropBoxCommand}"/>
                        <TextBox Text="{Binding DropBoxText, Mode=OneWay}" IsReadOnly="True"
                                 FontFamily="Consolas" FontSize="11"
                                 AcceptsReturn="True" TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 MinHeight="120" Margin="0,6,0,0"
                                 BorderThickness="0" Background="{StaticResource Bg.Sunken}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
