<Window x:Class="AdbToolkit.Views.PropEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:AdbToolkit.Resources"
        Title="{x:Static res:Strings.PropEdit_Title}"
        Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource Bg.Window}">
    <StackPanel Margin="16">
        <TextBlock Text="{x:Static res:Strings.SysDbg_ColProp}" FontSize="11.5" Foreground="{StaticResource Text.Secondary}"/>
        <TextBox Text="{Binding PropKey, Mode=OneWay}" IsReadOnly="True"
                 FontFamily="Consolas" Margin="0,4,0,12"/>

        <TextBlock Text="{x:Static res:Strings.PropEdit_NewValue}" FontSize="11.5" Foreground="{StaticResource Text.Secondary}"/>
        <TextBox x:Name="ValueBox"
                 Text="{Binding PropValue, UpdateSourceTrigger=PropertyChanged}"
                 FontFamily="Consolas" Margin="0,4,0,12"
                 KeyDown="ValueBox_KeyDown"/>

        <TextBlock FontSize="10.5" Foreground="{StaticResource Status.Warn}" TextWrapping="Wrap"
                   Text="{x:Static res:Strings.PropEdit_Warning}"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="{x:Static res:Strings.Common_Cancel}" Click="Cancel_Click"/>
            <Button Content="{x:Static res:Strings.Common_Ok}" Style="{StaticResource BtnAccent}" Margin="8,0,0,0" Click="Ok_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
