<Window x:Class="AdbToolkit.Views.PropEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="修改属性值"
        Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource Bg.Window}">
    <StackPanel Margin="16">
        <TextBlock Text="属性名" FontSize="11.5" Foreground="{StaticResource Text.Secondary}"/>
        <TextBox Text="{Binding PropKey, Mode=OneWay}" IsReadOnly="True"
                 FontFamily="Consolas" Margin="0,4,0,12"/>

        <TextBlock Text="新值" FontSize="11.5" Foreground="{StaticResource Text.Secondary}"/>
        <TextBox x:Name="ValueBox"
                 Text="{Binding PropValue, UpdateSourceTrigger=PropertyChanged}"
                 FontFamily="Consolas" Margin="0,4,0,12"
                 KeyDown="ValueBox_KeyDown"/>

        <TextBlock FontSize="10.5" Foreground="{StaticResource Status.Warn}" TextWrapping="Wrap"
                   Text="说明：setprop 需要 root 权限；ro. 开头的只读属性无法修改；非持久属性（无 persist 前缀）重启后会还原；修改系统属性可能影响设备行为。"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="取消" Click="Cancel_Click"/>
            <Button Content="确定" Style="{StaticResource BtnAccent}" Margin="8,0,0,0" Click="Ok_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
