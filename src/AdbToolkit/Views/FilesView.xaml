<UserControl x:Class="AdbToolkit.Views.FilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="360"/>
        </Grid.ColumnDefinitions>

        <!-- ======= 左：树形目录浏览（参考 Device Explorer） ======= -->
        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="设备文件浏览" Style="{StaticResource CardTitle}"/>

                <!-- 根路径栏 -->
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Content="设为根" Margin="8,0,0,0"
                            Style="{StaticResource BtnTool}" Command="{Binding SetRootCommand}"/>
                    <Button DockPanel.Dock="Right" Content="刷新选中" Margin="8,0,0,0"
                            Style="{StaticResource BtnTool}" Command="{Binding RefreshNodeCommand}"/>
                    <TextBox Text="{Binding RootPath, UpdateSourceTrigger=PropertyChanged}"
                             FontFamily="Consolas"
                             VerticalContentAlignment="Center"
                             KeyDown="RootPath_KeyDown"/>
                </DockPanel>

                <!-- 常用根目录 -->
                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock Text="快速设根：" VerticalAlignment="Center" FontSize="11.5"
                               Foreground="{StaticResource Text.Secondary}" Margin="0,0,4,0"/>
                    <Button Content="/" Style="{StaticResource BtnTool}" Click="RootRoot_Click"/>
                    <Button Content="/sdcard" Style="{StaticResource BtnTool}" Margin="6,0,0,0" Click="RootSdcard_Click"/>
                    <Button Content="/data/local/tmp" Style="{StaticResource BtnTool}" Margin="6,0,0,0" Click="RootTmp_Click"/>
                </WrapPanel>

                <!-- 列头（与 TreeView 各列宽度一一对应） -->
                <Border DockPanel.Dock="Top" Background="{StaticResource Bg.Sunken}"
                        CornerRadius="4" Padding="6,5" Margin="0,0,0,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="75"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="Name" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource Text.Secondary}"/>
                        <TextBlock Grid.Column="2" Text="Permissions" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource Text.Secondary}" Margin="8,0,0,0"/>
                        <TextBlock Grid.Column="3" Text="Date" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource Text.Secondary}" Margin="8,0,0,0"/>
                        <TextBlock Grid.Column="4" Text="Size" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource Text.Secondary}" HorizontalAlignment="Right"
                                   Margin="0,0,10,0"/>
                    </Grid>
                </Border>

                <!-- 状态栏（推送/拉取/操作反馈） -->
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Margin="2,8,0,0"
                           FontSize="11.5" Foreground="{StaticResource Text.Secondary}"/>

                <!-- 树形列表（懒加载；ItemTemplate 只含 Name 列，其余三列在 TreeViewItem 模板中） -->
                <TreeView ItemsSource="{Binding RootNodes}"
                          Style="{StaticResource FsTreeView}"
                          FontSize="12.5"
                          MouseDoubleClick="Tree_DoubleClick"
                          SelectedItemChanged="Tree_SelectedItemChanged"
                          PreviewMouseRightButtonDown="Tree_RightButtonDown"
                          ContextMenuOpening="Tree_ContextMenuOpening">
                    <TreeView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="推送文件到此目录..." Click="MenuPushFile_Click"/>
                            <MenuItem Header="推送文件夹到此目录..." Click="MenuPushFolder_Click"/>
                            <MenuItem Header="拉取到本机..." Click="MenuPull_Click"/>
                            <Separator/>
                            <MenuItem Header="新建文件夹..." Click="MenuCreateDir_Click"/>
                            <MenuItem Header="删除（递归）" Click="MenuDelete_Click"/>
                            <Separator/>
                            <MenuItem Header="刷新" Click="MenuRefresh_Click"/>
                            <MenuItem Header="复制完整路径" Click="MenuCopyPath_Click"/>
                        </ContextMenu>
                    </TreeView.ContextMenu>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           Text="{Binding Glyph}" FontSize="12"
                                           VerticalAlignment="Center" Margin="0,0,6,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource Text.Disabled}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsExpandable}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource Text.Disabled}"/>
                                                    <Setter Property="FontStyle" Value="Italic"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </DockPanel>
        </Border>

        <!-- ======= 右：传输操作 ======= -->
        <StackPanel Grid.Column="1">
            <Border Style="{StaticResource Card}" Padding="14">
                <StackPanel>
                    <TextBlock Text="推送到选中目录" Style="{StaticResource CardTitle}"/>
                    <TextBox Text="{Binding LocalPath, UpdateSourceTrigger=PropertyChanged}"
                             FontFamily="Consolas"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="浏览文件..." Command="{Binding BrowseLocalCommand}"/>
                        <Button Content="推送" Style="{StaticResource BtnAccent}" Margin="8,0,0,0"
                                Command="{Binding PushCommand}"/>
                    </StackPanel>
                    <TextBlock FontSize="10.5" Foreground="{StaticResource Text.Secondary}"
                               Margin="0,8,0,0" TextWrapping="Wrap"
                               Text="目标：树中选中的目录 > 选中文件的父目录 > 根目录。文件夹会整个拷入目标下。"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="14">
                <StackPanel>
                    <TextBlock Text="拉取到本机" Style="{StaticResource CardTitle}"/>
                    <TextBlock FontSize="11.5" Foreground="{StaticResource Text.Secondary}"
                               Text="拉取对象：树中选中项（未选中则拉取根路径）；双击文件可直接拉取"/>
                    <TextBlock Text="本机保存目录" FontSize="11.5" Margin="0,8,0,4"
                               Foreground="{StaticResource Text.Secondary}"/>
                    <TextBox Text="{Binding LocalDir, UpdateSourceTrigger=PropertyChanged}"
                             FontFamily="Consolas"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="拉取" Style="{StaticResource BtnAccent}"
                                Command="{Binding PullCommand}"/>
                        <Button Content="打开文件夹" Margin="8,0,0,0"
                                Command="{Binding OpenFolderCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="14">
                <StackPanel>
                    <TextBlock Text="目录操作" Style="{StaticResource CardTitle}"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="新建" Margin="8,0,0,0"
                                Style="{StaticResource BtnTool}" Command="{Binding CreateDirCommand}"/>
                        <TextBox Text="{Binding NewDirName, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalContentAlignment="Center"/>
                    </DockPanel>
                    <TextBlock FontSize="10.5" Foreground="{StaticResource Text.Secondary}"
                               Margin="0,6,0,0"
                               Text="在选中目录（或选中文件的父目录）下创建。"/>
                    <Button Content="删除选中项（递归）" Margin="0,8,0,0"
                            Style="{StaticResource BtnDanger}"
                            Command="{Binding DeleteCommand}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
