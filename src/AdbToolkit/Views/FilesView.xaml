<UserControl x:Class="AdbToolkit.Views.FilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:AdbToolkit.Resources">

    <!-- 应用级隐式 TextBlock 样式不穿透 UserControl 模板边界，本地补一份保证文字跟随主题 -->
    <UserControl.Resources>
        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"/>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="360"/>
        </Grid.ColumnDefinitions>

        <!-- ======= 左：树形目录浏览（参考 Device Explorer） ======= -->
        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{x:Static res:Strings.Files_BrowseTitle}" Style="{StaticResource CardTitle}"/>

                <!-- 根路径栏 -->
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Content="{x:Static res:Strings.Files_SetRoot}" Margin="8,0,0,0"
                            Style="{StaticResource BtnTool}" Command="{Binding SetRootCommand}"/>
                    <Button DockPanel.Dock="Right" Content="{x:Static res:Strings.Files_RefreshSelected}" Margin="8,0,0,0"
                            Style="{StaticResource BtnTool}" Command="{Binding RefreshNodeCommand}"/>
                    <TextBox Text="{Binding RootPath, UpdateSourceTrigger=PropertyChanged}"
                             FontFamily="Consolas"
                             VerticalContentAlignment="Center"
                             KeyDown="RootPath_KeyDown"/>
                </DockPanel>

                <!-- 常用根目录 -->
                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock Text="{x:Static res:Strings.Files_QuickRoots}" VerticalAlignment="Center" FontSize="11.5"
                               Foreground="{StaticResource Text.Secondary}" Margin="0,0,4,0"/>
                    <Button Content="/" Style="{StaticResource BtnTool}" Click="RootRoot_Click"/>
                    <Button Content="/sdcard" Style="{StaticResource BtnTool}" Margin="6,0,0,0" Click="RootSdcard_Click"/>
                    <Button Content="/data/local/tmp" Style="{StaticResource BtnTool}" Margin="6,0,0,0" Click="RootTmp_Click"/>
                </WrapPanel>

                <!-- 列头（与 TreeView 各列宽度一一对应） -->
                <Border DockPanel.Dock="Top" Background="{StaticResource Bg.Sunken}"
                        CornerRadius="4" Padding="6,5" Margin="0,0,0,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="75"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="Name" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource Text.Secondary}"/>
                        <TextBlock Grid.Column="2" Text="Permissions" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource Text.Secondary}" Margin="8,0,0,0"/>
                        <TextBlock Grid.Column="3" Text="Date" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource Text.Secondary}" Margin="8,0,0,0"/>
                        <TextBlock Grid.Column="4" Text="Size" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource Text.Secondary}" HorizontalAlignment="Right"
                                   Margin="0,0,10,0"/>
                    </Grid>
                </Border>

                <!-- 状态栏（推送/拉取/操作反馈） -->
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Margin="2,8,0,0"
                           FontSize="11.5" Foreground="{StaticResource Text.Secondary}"/>

                <!-- 树形列表（懒加载；ItemTemplate 只含 Name 列，其余三列在 TreeViewItem 模板中） -->
                <TreeView ItemsSource="{Binding RootNodes}"
                          Style="{StaticResource FsTreeView}"
                          FontSize="12.5"
                          MouseDoubleClick="Tree_DoubleClick"
                          SelectedItemChanged="Tree_SelectedItemChanged"
                          PreviewMouseRightButtonDown="Tree_RightButtonDown"
                          ContextMenuOpening="Tree_ContextMenuOpening">
                    <TreeView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{x:Static res:Strings.Files_MenuPushFile}" Click="MenuPushFile_Click"/>
                            <MenuItem Header="{x:Static res:Strings.Files_MenuPushFolder}" Click="MenuPushFolder_Click"/>
                            <MenuItem Header="{x:Static res:Strings.Files_MenuPull}" Click="MenuPull_Click"/>
                            <Separator/>
                            <MenuItem Header="{x:Static res:Strings.Files_MenuCreateDir}" Click="MenuCreateDir_Click"/>
                            <MenuItem Header="{x:Static res:Strings.Files_MenuDelete}" Click="MenuDelete_Click"/>
                            <Separator/>
                            <MenuItem Header="{x:Static res:Strings.Common_Refresh}" Click="MenuRefresh_Click"/>
                            <MenuItem Header="{x:Static res:Strings.Files_MenuCopyPath}" Click="MenuCopyPath_Click"/>
                        </ContextMenu>
                    </TreeView.ContextMenu>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           Text="{Binding Glyph}" FontSize="12"
                                           VerticalAlignment="Center" Margin="0,0,6,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource Text.Disabled}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsExpandable}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource Text.Disabled}"/>
                                                    <Setter Property="FontStyle" Value="Italic"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </DockPanel>
        </Border>

        <!-- ======= 右：传输操作 ======= -->
        <StackPanel Grid.Column="1">
            <Border Style="{StaticResource Card}" Padding="14">
                <StackPanel>
                    <TextBlock Text="{x:Static res:Strings.Files_PushTitle}" Style="{StaticResource CardTitle}"/>
                    <TextBox Text="{Binding LocalPath, UpdateSourceTrigger=PropertyChanged}"
                             FontFamily="Consolas"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="{x:Static res:Strings.Files_BrowseFiles}" Command="{Binding BrowseLocalCommand}"/>
                        <Button Content="{x:Static res:Strings.Files_Push}" Style="{StaticResource BtnAccent}" Margin="8,0,0,0"
                                Command="{Binding PushCommand}"/>
                    </StackPanel>
                    <TextBlock FontSize="10.5" Foreground="{StaticResource Text.Secondary}"
                               Margin="0,8,0,0" TextWrapping="Wrap"
                               Text="{x:Static res:Strings.Files_PushHelp}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="14">
                <StackPanel>
                    <TextBlock Text="{x:Static res:Strings.Files_PullTitle}" Style="{StaticResource CardTitle}"/>
                    <TextBlock FontSize="11.5" Foreground="{StaticResource Text.Secondary}"
                               Text="{x:Static res:Strings.Files_PullTargetHint}"/>
                    <TextBlock Text="{x:Static res:Strings.Files_LocalDirLabel}" FontSize="11.5" Margin="0,8,0,4"
                               Foreground="{StaticResource Text.Secondary}"/>
                    <TextBox Text="{Binding LocalDir, UpdateSourceTrigger=PropertyChanged}"
                             FontFamily="Consolas"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="{x:Static res:Strings.Files_Pull}" Style="{StaticResource BtnAccent}"
                                Command="{Binding PullCommand}"/>
                        <Button Content="{x:Static res:Strings.Files_OpenFolder}" Margin="8,0,0,0"
                                Command="{Binding OpenFolderCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="14">
                <StackPanel>
                    <TextBlock Text="{x:Static res:Strings.Files_DirOpsTitle}" Style="{StaticResource CardTitle}"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="{x:Static res:Strings.Files_CreateDir}" Margin="8,0,0,0"
                                Style="{StaticResource BtnTool}" Command="{Binding CreateDirCommand}"/>
                        <TextBox Text="{Binding NewDirName, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalContentAlignment="Center"/>
                    </DockPanel>
                    <TextBlock FontSize="10.5" Foreground="{StaticResource Text.Secondary}"
                               Margin="0,6,0,0"
                               Text="{x:Static res:Strings.Files_CreateDirHelp}"/>
                    <Button Content="{x:Static res:Strings.Files_DeleteSelected}" Margin="0,8,0,0"
                            Style="{StaticResource BtnDanger}"
                            Command="{Binding DeleteCommand}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
