<UserControl x:Class="AdbToolkit.Views.ScreenInputView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Unloaded="View_Unloaded">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <!-- ======= 截图 / 录屏 ======= -->
            <Border Style="{StaticResource Card}" Padding="16">
                <StackPanel>
                    <TextBlock Text="截图 / 录屏" Style="{StaticResource CardTitle}"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="截图" Style="{StaticResource BtnAccent}"
                                Command="{Binding ShotCommand}"/>
                        <Button Content="打开文件夹" Margin="8,0,0,0"
                                Command="{Binding OpenFolderCommand}"/>
                        <TextBlock Text="{Binding ShotFolder}" VerticalAlignment="Center"
                                   Margin="16,0,0,0" FontSize="11" FontFamily="Consolas"
                                   Foreground="{StaticResource Text.Secondary}"/>
                    </StackPanel>

                    <Separator Background="{StaticResource Divider}" Margin="0,12"/>
                    <WrapPanel VerticalAlignment="Center">
                        <TextBlock Text="码率(Mbps)" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{StaticResource Text.Secondary}" Margin="0,0,6,0"/>
                        <ComboBox ItemsSource="{Binding Bitrates}" SelectedItem="{Binding SelectedBitrate}" Width="60"/>
                        <TextBlock Text="时长(s)" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{StaticResource Text.Secondary}" Margin="12,0,6,0"/>
                        <TextBox Text="{Binding TimeLimit}" Width="50"/>
                        <TextBlock Text="分辨率" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{StaticResource Text.Secondary}" Margin="12,0,6,0"/>
                        <ComboBox ItemsSource="{Binding Sizes}" SelectedItem="{Binding SelectedSize}" Width="110"/>
                        <Button Content="开始录屏" Margin="12,0,0,0" Command="{Binding RecordStartCommand}"/>
                        <Button Content="停止并拉取" Style="{StaticResource BtnAccent}" Margin="8,0,0,0"
                                Command="{Binding RecordStopCommand}"/>
                        <TextBlock Text="最长 3 分钟（adb 限制）" FontSize="10.5" VerticalAlignment="Center"
                                   Foreground="{StaticResource Text.Secondary}" Margin="10,0,0,0"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- ======= 快捷键面板 ======= -->
            <Border Style="{StaticResource Card}" Padding="16" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="快捷键面板" Style="{StaticResource CardTitle}"/>
                    <ItemsControl ItemsSource="{Binding QuickKeys}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Label}" Margin="0,0,8,8"
                                        Command="{Binding DataContext.QuickKeyCommand,
                                            RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding Command}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ======= 键盘透传 ======= -->
            <Border Style="{StaticResource Card}" Padding="16" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="键盘透传（PC → 设备）" Style="{StaticResource CardTitle}"/>
                    <TextBlock FontSize="11.5" Foreground="{StaticResource Text.Secondary}"
                               TextWrapping="Wrap" Margin="0,0,0,10" LineHeight="18"
                               Text="打开键盘窗口并点击获得焦点后，PC 键盘的打字（input text 批量发送）、回车/方向键等系统键（keyevent）、Ctrl/Alt 组合（keycombination，Android 11+）都会实时转发到当前选中的设备；长按自动重复，快速打字自动合并。"/>
                    <Button Content="打开键盘窗口" Style="{StaticResource BtnAccent}"
                            HorizontalAlignment="Left"
                            Click="OpenKeyboardWindow_Click"/>
                </StackPanel>
            </Border>

            <!-- ======= 文本 / 坐标 ======= -->
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="16" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="文本注入" Style="{StaticResource CardTitle}"/>
                        <TextBox Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="发送文本" Style="{StaticResource BtnAccent}"
                                    Command="{Binding SendTextCommand}"/>
                            <Button Content="回车键" Margin="8,0,0,0"
                                    Command="{Binding QuickKeyCommand}" CommandParameter="input keyevent 66"/>
                        </StackPanel>
                        <TextBlock FontSize="10.5" Foreground="{StaticResource Text.Secondary}"
                                   Margin="0,8,0,0" TextWrapping="Wrap"
                                   Text="仅支持 ASCII；中文请借助设备端剪贴板粘贴，或后续接入自研 IME。"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="坐标点击 / 滑动" Style="{StaticResource CardTitle}"/>
                        <WrapPanel VerticalAlignment="Center">
                            <TextBlock Text="点击 X" VerticalAlignment="Center" FontSize="12" Margin="0,0,4,0"/>
                            <TextBox Text="{Binding TapX}" Width="60"/>
                            <TextBlock Text="Y" VerticalAlignment="Center" FontSize="12" Margin="8,0,4,0"/>
                            <TextBox Text="{Binding TapY}" Width="60"/>
                            <Button Content="点击" Style="{StaticResource BtnAccent}" Margin="10,0,0,0"
                                    Command="{Binding TapCommand}"/>
                        </WrapPanel>
                        <WrapPanel VerticalAlignment="Center" Margin="0,10,0,0">
                            <TextBlock Text="起点" VerticalAlignment="Center" FontSize="12" Margin="0,0,4,0"/>
                            <TextBox Text="{Binding SwipeX1}" Width="55"/>
                            <TextBox Text="{Binding SwipeY1}" Width="55" Margin="4,0,0,0"/>
                            <TextBlock Text="→ 终点" VerticalAlignment="Center" FontSize="12" Margin="8,0,4,0"/>
                            <TextBox Text="{Binding SwipeX2}" Width="55"/>
                            <TextBox Text="{Binding SwipeY2}" Width="55" Margin="4,0,0,0"/>
                            <TextBlock Text="ms" VerticalAlignment="Center" FontSize="12" Margin="8,0,4,0"/>
                            <TextBox Text="{Binding SwipeMs}" Width="50"/>
                            <Button Content="滑动" Style="{StaticResource BtnAccent}" Margin="10,0,0,0"
                                    Command="{Binding SwipeCommand}"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ======= UI 层级 / Monkey ======= -->
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="16" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="UI 层级 dump" Style="{StaticResource CardTitle}"/>
                        <Button Content="dump 当前界面到本机" Style="{StaticResource BtnAccent}"
                                HorizontalAlignment="Left"
                                Command="{Binding UiDumpCommand}"/>
                        <TextBlock FontSize="10.5" Foreground="{StaticResource Text.Secondary}"
                                   Margin="0,8,0,0" TextWrapping="Wrap"
                                   Text="uiautomator dump → 拉取 XML，可用于自动化元素定位。dump 时界面需保持静止。"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Monkey 压力测试" Style="{StaticResource CardTitle}"/>
                        <WrapPanel VerticalAlignment="Center">
                            <TextBox Text="{Binding MonkeyPackage, UpdateSourceTrigger=PropertyChanged}"
                                     Width="170" FontFamily="Consolas"/>
                            <TextBlock Text="事件数" VerticalAlignment="Center" FontSize="12" Margin="8,0,4,0"/>
                            <TextBox Text="{Binding MonkeyCount}" Width="55"/>
                            <TextBlock Text="节流ms" VerticalAlignment="Center" FontSize="12" Margin="8,0,4,0"/>
                            <TextBox Text="{Binding MonkeyThrottle}" Width="50"/>
                            <TextBlock Text="seed" VerticalAlignment="Center" FontSize="12" Margin="8,0,4,0"/>
                            <TextBox Text="{Binding MonkeySeed}" Width="55"/>
                        </WrapPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="开始" Style="{StaticResource BtnAccent}"
                                    Command="{Binding MonkeyStartCommand}"/>
                            <Button Content="停止" Style="{StaticResource BtnDanger}" Margin="8,0,0,0"
                                    Command="{Binding MonkeyStopCommand}"/>
                        </StackPanel>
                        <TextBox Text="{Binding Status, Mode=OneWay}" IsReadOnly="True"
                                 Margin="0,8,0,0" BorderThickness="0" Background="Transparent"
                                 FontSize="11.5" Foreground="{StaticResource Text.Secondary}"/>
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
