<UserControl x:Class="AdbToolkit.Views.ScreenInputView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:AdbToolkit.Resources"
             Unloaded="View_Unloaded">

    <!-- 应用级隐式 TextBlock 样式不穿透 UserControl 模板边界，本地补一份保证文字跟随主题 -->
    <UserControl.Resources>
        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <!-- ======= 截图 / 录屏 ======= -->
            <Border Style="{StaticResource Card}" Padding="16">
                <StackPanel>
                    <TextBlock Text="{x:Static res:Strings.Screen_ShotRecordTitle}" Style="{StaticResource CardTitle}"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{x:Static res:Strings.Screen_Screenshot}" Style="{StaticResource BtnAccent}"
                                Command="{Binding ShotCommand}"/>
                        <Button Content="{x:Static res:Strings.Files_OpenFolder}" Margin="8,0,0,0"
                                Command="{Binding OpenFolderCommand}"/>
                        <TextBlock Text="{Binding ShotFolder}" VerticalAlignment="Center"
                                   Margin="16,0,0,0" FontSize="11" FontFamily="Consolas"
                                   Foreground="{StaticResource Text.Secondary}"/>
                    </StackPanel>

                    <Separator Background="{StaticResource Divider}" Margin="0,12"/>
                    <WrapPanel VerticalAlignment="Center">
                        <TextBlock Text="{x:Static res:Strings.Screen_Bitrate}" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{StaticResource Text.Secondary}" Margin="0,0,6,0"/>
                        <ComboBox ItemsSource="{Binding Bitrates}" SelectedItem="{Binding SelectedBitrate}" Width="60"/>
                        <TextBlock Text="{x:Static res:Strings.Screen_TimeLimit}" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{StaticResource Text.Secondary}" Margin="12,0,6,0"/>
                        <TextBox Text="{Binding TimeLimit}" Width="50"/>
                        <TextBlock Text="{x:Static res:Strings.Screen_Resolution}" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{StaticResource Text.Secondary}" Margin="12,0,6,0"/>
                        <ComboBox ItemsSource="{Binding Sizes}" SelectedItem="{Binding SelectedSize}" Width="110"/>
                        <Button Content="{x:Static res:Strings.Screen_RecordStart}" Margin="12,0,0,0" Command="{Binding RecordStartCommand}"/>
                        <Button Content="{x:Static res:Strings.Screen_RecordStop}" Style="{StaticResource BtnAccent}" Margin="8,0,0,0"
                                Command="{Binding RecordStopCommand}"/>
                        <TextBlock Text="{x:Static res:Strings.Screen_RecordLimitHint}" FontSize="10.5" VerticalAlignment="Center"
                                   Foreground="{StaticResource Text.Secondary}" Margin="10,0,0,0"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- ======= 快捷键面板 ======= -->
            <Border Style="{StaticResource Card}" Padding="16" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="{x:Static res:Strings.Screen_QuickKeysTitle}" Style="{StaticResource CardTitle}"/>
                    <ItemsControl ItemsSource="{Binding QuickKeys}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Label}" Margin="0,0,8,8"
                                        Command="{Binding DataContext.QuickKeyCommand,
                                            RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding Command}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ======= 键盘透传 ======= -->
            <Border Style="{StaticResource Card}" Padding="16" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="{x:Static res:Strings.Screen_KeyboardForwardTitle}" Style="{StaticResource CardTitle}"/>
                    <TextBlock FontSize="11.5" Foreground="{StaticResource Text.Secondary}"
                               TextWrapping="Wrap" Margin="0,0,0,10" LineHeight="18"
                               Text="{x:Static res:Strings.Screen_KeyboardForwardHelp}"/>
                    <Button Content="{x:Static res:Strings.Screen_OpenKeyboardWindow}" Style="{StaticResource BtnAccent}"
                            HorizontalAlignment="Left"
                            Click="OpenKeyboardWindow_Click"/>
                </StackPanel>
            </Border>

            <!-- ======= 文本 / 坐标 ======= -->
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="16" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="{x:Static res:Strings.Screen_TextInjectTitle}" Style="{StaticResource CardTitle}"/>
                        <TextBox Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="{x:Static res:Strings.Screen_SendText}" Style="{StaticResource BtnAccent}"
                                    Command="{Binding SendTextCommand}"/>
                            <Button Content="{x:Static res:Strings.Screen_EnterKey}" Margin="8,0,0,0"
                                    Command="{Binding QuickKeyCommand}" CommandParameter="input keyevent 66"/>
                        </StackPanel>
                        <TextBlock FontSize="10.5" Foreground="{StaticResource Text.Secondary}"
                                   Margin="0,8,0,0" TextWrapping="Wrap"
                                   Text="{x:Static res:Strings.Screen_TextInjectHelp}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="{x:Static res:Strings.Screen_TapSwipeTitle}" Style="{StaticResource CardTitle}"/>
                        <WrapPanel VerticalAlignment="Center">
                            <TextBlock Text="{x:Static res:Strings.Screen_TapX}" VerticalAlignment="Center" FontSize="12" Margin="0,0,4,0"/>
                            <TextBox Text="{Binding TapX}" Width="60"/>
                            <TextBlock Text="Y" VerticalAlignment="Center" FontSize="12" Margin="8,0,4,0"/>
                            <TextBox Text="{Binding TapY}" Width="60"/>
                            <Button Content="{x:Static res:Strings.Screen_Tap}" Style="{StaticResource BtnAccent}" Margin="10,0,0,0"
                                    Command="{Binding TapCommand}"/>
                        </WrapPanel>
                        <WrapPanel VerticalAlignment="Center" Margin="0,10,0,0">
                            <TextBlock Text="{x:Static res:Strings.Screen_StartPoint}" VerticalAlignment="Center" FontSize="12" Margin="0,0,4,0"/>
                            <TextBox Text="{Binding SwipeX1}" Width="55"/>
                            <TextBox Text="{Binding SwipeY1}" Width="55" Margin="4,0,0,0"/>
                            <TextBlock Text="{x:Static res:Strings.Screen_EndPoint}" VerticalAlignment="Center" FontSize="12" Margin="8,0,4,0"/>
                            <TextBox Text="{Binding SwipeX2}" Width="55"/>
                            <TextBox Text="{Binding SwipeY2}" Width="55" Margin="4,0,0,0"/>
                            <TextBlock Text="ms" VerticalAlignment="Center" FontSize="12" Margin="8,0,4,0"/>
                            <TextBox Text="{Binding SwipeMs}" Width="50"/>
                            <Button Content="{x:Static res:Strings.Screen_Swipe}" Style="{StaticResource BtnAccent}" Margin="10,0,0,0"
                                    Command="{Binding SwipeCommand}"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ======= UI 层级 / Monkey ======= -->
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="16" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="{x:Static res:Strings.Screen_UiDumpTitle}" Style="{StaticResource CardTitle}"/>
                        <Button Content="{x:Static res:Strings.Screen_UiDumpButton}" Style="{StaticResource BtnAccent}"
                                HorizontalAlignment="Left"
                                Command="{Binding UiDumpCommand}"/>
                        <TextBlock FontSize="10.5" Foreground="{StaticResource Text.Secondary}"
                                   Margin="0,8,0,0" TextWrapping="Wrap"
                                   Text="{x:Static res:Strings.Screen_UiDumpHelp}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="{x:Static res:Strings.Screen_MonkeyTitle}" Style="{StaticResource CardTitle}"/>
                        <WrapPanel VerticalAlignment="Center">
                            <TextBox Text="{Binding MonkeyPackage, UpdateSourceTrigger=PropertyChanged}"
                                     Width="170" FontFamily="Consolas"/>
                            <TextBlock Text="{x:Static res:Strings.Screen_EventCount}" VerticalAlignment="Center" FontSize="12" Margin="8,0,4,0"/>
                            <TextBox Text="{Binding MonkeyCount}" Width="55"/>
                            <TextBlock Text="{x:Static res:Strings.Screen_Throttle}" VerticalAlignment="Center" FontSize="12" Margin="8,0,4,0"/>
                            <TextBox Text="{Binding MonkeyThrottle}" Width="50"/>
                            <TextBlock Text="seed" VerticalAlignment="Center" FontSize="12" Margin="8,0,4,0"/>
                            <TextBox Text="{Binding MonkeySeed}" Width="55"/>
                        </WrapPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="{x:Static res:Strings.More_DeviceLogStart}" Style="{StaticResource BtnAccent}"
                                    Command="{Binding MonkeyStartCommand}"/>
                            <Button Content="{x:Static res:Strings.Logcat_Stop}" Style="{StaticResource BtnDanger}" Margin="8,0,0,0"
                                    Command="{Binding MonkeyStopCommand}"/>
                        </StackPanel>
                        <TextBox Text="{Binding Status, Mode=OneWay}" IsReadOnly="True"
                                 Margin="0,8,0,0" BorderThickness="0" Background="Transparent"
                                 FontSize="11.5" Foreground="{StaticResource Text.Secondary}"/>
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
