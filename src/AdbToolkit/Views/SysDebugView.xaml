<UserControl x:Class="AdbToolkit.Views.SysDebugView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:AdbToolkit.Resources">

    <!-- 应用级隐式 TextBlock 样式不穿透 UserControl 模板边界，本地补一份保证文字跟随主题 -->
    <UserControl.Resources>
        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" Background="Transparent" BorderThickness="0"
                    SelectionChanged="Tabs_SelectionChanged">

            <!-- ============ Tab 1: 系统设置 ============ -->
            <TabItem Header="{x:Static res:Strings.SysDbg_TabSettings}">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="330"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12" Margin="0,0,12,0">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <Button DockPanel.Dock="Right" Content="{x:Static res:Strings.Apps_Search}" Style="{StaticResource BtnTool}" Margin="8,0,0,0"
                                        Command="{Binding SearchSettingsCommand}"/>
                                <ComboBox ItemsSource="{Binding Namespaces}"
                                          SelectedItem="{Binding SelectedNamespace}" Width="90"/>
                                <TextBox Text="{Binding SettingsSearch, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="8,0,0,0" VerticalContentAlignment="Center"/>
                            </DockPanel>
                            <ListView ItemsSource="{Binding SettingsItems}" FontSize="12" BorderThickness="0"
                                      FontFamily="Consolas">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="{x:Static res:Strings.SysDbg_Key}" Width="240"
                                                        DisplayMemberBinding="{Binding Key}"/>
                                        <GridViewColumn Header="{x:Static res:Strings.SysDbg_Value}" Width="420"
                                                        DisplayMemberBinding="{Binding Value}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource Card}" Padding="14" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="{x:Static res:Strings.SysDbg_SingleItemTitle}" Style="{StaticResource CardTitle}"/>
                            <TextBlock Text="{x:Static res:Strings.SysDbg_KeyName}" FontSize="11.5" Foreground="{StaticResource Text.Secondary}"/>
                            <TextBox Text="{Binding SettingKey, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8"/>
                            <TextBlock Text="{x:Static res:Strings.SysDbg_Value}" FontSize="11.5" Foreground="{StaticResource Text.Secondary}"/>
                            <TextBox Text="{Binding SettingValue, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8"/>
                            <WrapPanel>
                                <Button Content="{x:Static res:Strings.SysDbg_Read}" Command="{Binding GetSettingCommand}"/>
                                <Button Content="{x:Static res:Strings.SysDbg_Write}" Style="{StaticResource BtnAccent}" Margin="6,0,0,0"
                                        Command="{Binding PutSettingCommand}"/>
                                <Button Content="{x:Static res:Strings.Common_Delete}" Style="{StaticResource BtnDanger}" Margin="6,0,0,0"
                                        Command="{Binding DeleteSettingCommand}"/>
                            </WrapPanel>
                            <TextBlock FontSize="10.5" Foreground="{StaticResource Text.Secondary}"
                                       Margin="0,10,0,0" TextWrapping="Wrap"
                                       Text="{x:Static res:Strings.SysDbg_SettingsExample}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ============ Tab 2: 属性 getprop ============ -->
            <TabItem x:Name="PropsTabItem" Header="{x:Static res:Strings.SysDbg_TabProps}">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="330"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12" Margin="0,0,12,0">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                                <TextBox x:Name="PropSearchBox"
                                         Text="{Binding PropSearch, UpdateSourceTrigger=PropertyChanged}"
                                         VerticalContentAlignment="Center"
                                         KeyDown="PropSearch_KeyDown"/>
                                <Popup IsOpen="{Binding PropSuggestionsOpen, Mode=TwoWay}"
                                       PlacementTarget="{Binding ElementName=PropSearchBox}"
                                       Placement="Bottom"
                                       StaysOpen="False"
                                       AllowsTransparency="True"
                                       PopupAnimation="Fade">
                                    <Border Background="{StaticResource Bg.Card}"
                                            BorderBrush="{StaticResource Border}" BorderThickness="1"
                                            CornerRadius="4" MinWidth="320" MaxHeight="240"
                                            Margin="0,2,0,0">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.18"/>
                                        </Border.Effect>
                                        <ListBox x:Name="PropSuggestionsList"
                                                 ItemsSource="{Binding PropSuggestions}"
                                                 BorderThickness="0" Padding="4"
                                                 FontFamily="Consolas" FontSize="12"
                                                 PreviewMouseLeftButtonUp="PropSuggestions_Click"/>
                                    </Border>
                                </Popup>
                            </Grid>
                            <TextBlock DockPanel.Dock="Bottom" FontSize="10.5"
                                       Foreground="{StaticResource Text.Secondary}" Margin="0,6,0,0"
                                       Text="{x:Static res:Strings.SysDbg_PropHint}"/>
                            <ListView x:Name="PropsList"
                                      ItemsSource="{Binding Props}"
                                      SelectedItem="{Binding SelectedProp, Mode=TwoWay}"
                                      FontSize="12" BorderThickness="0"
                                      FontFamily="Consolas"
                                      PreviewMouseRightButtonDown="PropsList_PreviewMouseRightButtonDown"
                                      ContextMenuOpening="PropsList_ContextMenuOpening">
                                <ListView.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{x:Static res:Strings.SysDbg_MenuEditValue}" Click="EditProp_Click"/>
                                        <MenuItem Header="{x:Static res:Strings.SysDbg_MenuCopyKey}" Click="CopyPropKey_Click"/>
                                        <MenuItem Header="{x:Static res:Strings.SysDbg_MenuCopyValue}" Click="CopyPropValue_Click"/>
                                    </ContextMenu>
                                </ListView.ContextMenu>
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="{x:Static res:Strings.SysDbg_ColProp}" Width="320"
                                                        DisplayMemberBinding="{Binding Key}"/>
                                        <GridViewColumn Header="{x:Static res:Strings.SysDbg_Value}" Width="420"
                                                        DisplayMemberBinding="{Binding Value}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource Card}" Padding="14" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="{x:Static res:Strings.SysDbg_CommonPropsTitle}" Style="{StaticResource CardTitle}"/>
                            <ItemsControl FontSize="12" Foreground="{StaticResource Text.Secondary}">
                                <TextBlock Text="{x:Static res:Strings.SysDbg_PropHeapGrowth}"/>
                                <TextBlock Text="{x:Static res:Strings.SysDbg_PropHeapStart}" Margin="0,4,0,0"/>
                                <TextBlock Text="{x:Static res:Strings.SysDbg_PropHeapSize}" Margin="0,4,0,0"/>
                                <TextBlock Text="{x:Static res:Strings.SysDbg_PropLowRam}" Margin="0,4,0,0"/>
                                <TextBlock Text="{x:Static res:Strings.SysDbg_PropUsbConfig}" Margin="0,4,0,0"/>
                                <TextBlock Text="{x:Static res:Strings.SysDbg_PropAdbPort}" Margin="0,4,0,0"/>
                                <TextBlock Text="{x:Static res:Strings.SysDbg_PropPatch}" Margin="0,4,0,0"/>
                                <TextBlock Text="{x:Static res:Strings.SysDbg_PropPlatform}" Margin="0,4,0,0"/>
                            </ItemsControl>
                            <TextBlock FontSize="10.5" Foreground="{StaticResource Text.Secondary}"
                                       Margin="0,10,0,0" TextWrapping="Wrap"
                                       Text="{x:Static res:Strings.SysDbg_PropSearchHint}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ============ Tab 3: Intent 构造器 ============ -->
            <TabItem Header="{x:Static res:Strings.SysDbg_TabIntent}">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="360"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="16" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="{x:Static res:Strings.SysDbg_IntentBuildTitle}" Style="{StaticResource CardTitle}"/>
                            <TextBlock Text="{x:Static res:Strings.SysDbg_IntentActionLabel}" FontSize="11.5"
                                       Foreground="{StaticResource Text.Secondary}"/>
                            <TextBox Text="{Binding IntentAction, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8"/>
                            <TextBlock Text="{x:Static res:Strings.SysDbg_IntentUriLabel}" FontSize="11.5"
                                       Foreground="{StaticResource Text.Secondary}"/>
                            <TextBox Text="{Binding IntentUri, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8"/>
                            <TextBlock Text="{x:Static res:Strings.SysDbg_IntentComponentLabel}" FontSize="11.5"
                                       Foreground="{StaticResource Text.Secondary}"/>
                            <TextBox Text="{Binding IntentComponent, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8"/>
                            <TextBlock Text="{x:Static res:Strings.SysDbg_IntentExtrasLabel}" FontSize="11.5"
                                       Foreground="{StaticResource Text.Secondary}"/>
                            <TextBox Text="{Binding IntentExtras, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" MinHeight="70"
                                     VerticalScrollBarVisibility="Auto" Margin="0,4,0,8"/>
                            <Button Content="{x:Static res:Strings.SysDbg_IntentSend}" Style="{StaticResource BtnAccent}"
                                    HorizontalAlignment="Left" Command="{Binding RunIntentCommand}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource Card}" Padding="14">
                        <StackPanel>
                            <TextBlock Text="{x:Static res:Strings.SysDbg_IntentOutputTitle}" Style="{StaticResource CardTitle}"/>
                            <TextBox Text="{Binding IntentOutput, Mode=OneWay}" IsReadOnly="True"
                                     FontFamily="Consolas" FontSize="11.5"
                                     AcceptsReturn="True" TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                     MinHeight="200" BorderThickness="0"
                                     Background="{StaticResource Bg.Sunken}"/>
                            <TextBlock FontSize="10.5" Foreground="{StaticResource Text.Secondary}"
                                       Margin="0,10,0,0" TextWrapping="Wrap"
                                       Text="{x:Static res:Strings.SysDbg_IntentBroadcastHint}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ============ Tab 4: 设置页面 ============ -->
            <TabItem Header="{x:Static res:Strings.SysDbg_TabSettingsPages}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                    <StackPanel>
                        <!-- 应用详情直达 -->
                        <Border Style="{StaticResource Card}" Padding="16">
                            <StackPanel>
                                <TextBlock Text="{x:Static res:Strings.SysDbg_AppDetailsDirect}" Style="{StaticResource CardTitle}"/>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="{x:Static res:Strings.Common_Open}" Style="{StaticResource BtnAccent}"
                                            Margin="8,0,0,0"
                                            Command="{Binding OpenAppDetailsByPackageCommand}"/>
                                    <TextBox Text="{Binding SettingsPkgInput, UpdateSourceTrigger=PropertyChanged}"
                                             FontFamily="Consolas" VerticalContentAlignment="Center"/>
                                </DockPanel>
                                <TextBlock FontSize="10.5" Foreground="{StaticResource Text.Secondary}"
                                           Margin="0,8,0,0"
                                           Text="{x:Static res:Strings.SysDbg_AppDetailsDirectHint}"/>
                            </StackPanel>
                        </Border>

                        <!-- 通用 -->
                        <Border Style="{StaticResource Card}" Padding="16" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="{x:Static res:Strings.SysDbg_SecGeneral}" Style="{StaticResource CardTitle}"/>
                                <ItemsControl ItemsSource="{Binding SettingsGeneral}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding Label}" Margin="0,0,8,8"
                                                    ToolTip="{Binding Action}"
                                                    Command="{Binding DataContext.OpenSettingsCommand,
                                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding Action}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- 应用与权限 -->
                        <Border Style="{StaticResource Card}" Padding="16" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="{x:Static res:Strings.SysDbg_SecAppsPerms}" Style="{StaticResource CardTitle}"/>
                                <ItemsControl ItemsSource="{Binding SettingsApps}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding Label}" Margin="0,0,8,8"
                                                    ToolTip="{Binding Action}"
                                                    Command="{Binding DataContext.OpenSettingsCommand,
                                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding Action}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- 网络 -->
                        <Border Style="{StaticResource Card}" Padding="16" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="{x:Static res:Strings.SysDbg_SecNetwork}" Style="{StaticResource CardTitle}"/>
                                <ItemsControl ItemsSource="{Binding SettingsNetwork}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding Label}" Margin="0,0,8,8"
                                                    ToolTip="{Binding Action}"
                                                    Command="{Binding DataContext.OpenSettingsCommand,
                                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding Action}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- 设备 -->
                        <Border Style="{StaticResource Card}" Padding="16" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="{x:Static res:Strings.SysDbg_SecDevice}" Style="{StaticResource CardTitle}"/>
                                <ItemsControl ItemsSource="{Binding SettingsDevice}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding Label}" Margin="0,0,8,8"
                                                    ToolTip="{Binding Action}"
                                                    Command="{Binding DataContext.OpenSettingsCommand,
                                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding Action}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <TextBlock FontSize="10.5" Foreground="{StaticResource Text.Secondary}"
                                   Margin="4,4,0,0"
                                   Text="{x:Static res:Strings.SysDbg_SettingsPageHint}"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ Tab 5: 调试预设 ============ -->
            <TabItem Header="{x:Static res:Strings.SysDbg_TabPresets}">
                <Border Style="{StaticResource Card}" Padding="16" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="{x:Static res:Strings.SysDbg_PresetPanelTitle}" Style="{StaticResource CardTitle}"/>
                        <ItemsControl ItemsSource="{Binding Presets}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="215" Margin="0,0,10,10"
                                            Background="{StaticResource Bg.Sunken}"
                                            BorderBrush="{StaticResource Divider}"
                                            BorderThickness="1" CornerRadius="6" Padding="10">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="12.5"/>
                                            <TextBlock Text="{Binding Description}" FontSize="10.5"
                                                       Foreground="{StaticResource Text.Secondary}"
                                                       TextWrapping="Wrap" Margin="0,2,0,6" MinHeight="28"/>
                                            <Button Content="{x:Static res:Strings.SysDbg_Run}" Style="{StaticResource BtnAccent}" Padding="14,4"
                                                    HorizontalAlignment="Left"
                                                    Command="{Binding DataContext.ApplyPresetCommand,
                                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{x:Static res:Strings.SysDbg_RunResultTitle}" Style="{StaticResource CardTitle}" Margin="0,10,0,4"/>
                        <TextBox Text="{Binding TerminalOutput, Mode=OneWay}" IsReadOnly="True"
                                 FontFamily="Consolas" FontSize="11.5"
                                 AcceptsReturn="True" TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 MinHeight="100" BorderThickness="0"
                                 Background="{StaticResource Bg.Sunken}"/>
                    </StackPanel>
                </Border>
            </TabItem>

            <!-- ============ Tab 6: SELinux 与高危操作 ============ -->
            <TabItem Header="{x:Static res:Strings.SysDbg_TabSelinux}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                    <StackPanel>
                        <Border Style="{StaticResource Card}" Padding="16">
                            <StackPanel>
                                <TextBlock Text="{x:Static res:Strings.SysDbg_SelinuxTitle}" Style="{StaticResource CardTitle}"/>
                                <WrapPanel VerticalAlignment="Center">
                                    <TextBlock Text="{x:Static res:Strings.SysDbg_CurrentState}" VerticalAlignment="Center" FontSize="12.5"/>
                                    <TextBlock Text="{Binding EnforceState}" VerticalAlignment="Center"
                                               FontWeight="Bold" Margin="4,0,14,0"/>
                                    <Button Content="{x:Static res:Strings.SysDbg_View}" Command="{Binding GetEnforceCommand}"/>
                                    <Button Content="Permissive (0)" Margin="8,0,0,0"
                                            Command="{Binding SetEnforceCommand}" CommandParameter="0"/>
                                    <Button Content="Enforcing (1)" Margin="8,0,0,0"
                                            Command="{Binding SetEnforceCommand}" CommandParameter="1"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Padding="16" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="{x:Static res:Strings.SysDbg_PersistTitle}" Style="{StaticResource CardTitle}"/>
                                <WrapPanel VerticalAlignment="Center">
                                    <TextBlock Text="{x:Static res:Strings.SysDbg_Port}" VerticalAlignment="Center" FontSize="12" Margin="0,0,6,0"/>
                                    <TextBox Text="{Binding PersistPort}" Width="70"/>
                                    <Button Content="{x:Static res:Strings.SysDbg_PersistWrite}" Style="{StaticResource BtnAccent}" Margin="10,0,0,0"
                                            Command="{Binding PersistAdbCommand}"/>
                                </WrapPanel>
                                <TextBlock FontSize="10.5" Foreground="{StaticResource Text.Secondary}"
                                           Margin="0,8,0,0" TextWrapping="Wrap"
                                           Text="{x:Static res:Strings.SysDbg_PersistHelp}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Padding="16" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="{x:Static res:Strings.SysDbg_PstoreTitle}" Style="{StaticResource CardTitle}"/>
                                <WrapPanel VerticalAlignment="Center">
                                    <Button Content="{x:Static res:Strings.SysDbg_PstoreView}" Command="{Binding ListPstoreCommand}"/>
                                    <Button Content="{x:Static res:Strings.SysDbg_PstorePull}" Style="{StaticResource BtnAccent}" Margin="8,0,0,0"
                                            Command="{Binding PullPstoreCommand}"/>
                                </WrapPanel>
                                <TextBox Text="{Binding PstoreList, Mode=OneWay}" IsReadOnly="True"
                                         FontFamily="Consolas" FontSize="11.5"
                                         AcceptsReturn="True" TextWrapping="NoWrap"
                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                         MinHeight="90" Margin="0,8,0,0"
                                         BorderThickness="0" Background="{StaticResource Bg.Sunken}"/>
                                <TextBlock FontSize="10.5" Foreground="{StaticResource Text.Secondary}"
                                           Margin="0,8,0,0"
                                           Text="{x:Static res:Strings.SysDbg_PstoreHint}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Padding="16" Margin="0,12,0,0"
                                BorderBrush="{StaticResource Danger.Border}">
                            <StackPanel>
                                <TextBlock Text="{x:Static res:Strings.SysDbg_PropFileTitle}" Style="{StaticResource CardTitle}"
                                           Foreground="{StaticResource Status.Error}"/>
                                <WrapPanel VerticalAlignment="Center" Margin="0,0,0,8">
                                    <ComboBox Width="220"
                                              ItemsSource="{Binding PropFilePaths}"
                                              SelectedItem="{Binding PropFilePath}"/>
                                    <Button Content="{x:Static res:Strings.SysDbg_Read}" Margin="8,0,0,0" Command="{Binding ReadPropFileCommand}"/>
                                    <Button Content="{x:Static res:Strings.SysDbg_PropFileSave}" Style="{StaticResource BtnDanger}" Margin="8,0,0,0"
                                            Command="{Binding SavePropFileCommand}"/>
                                </WrapPanel>
                                <TextBox Text="{Binding PropFileContent, UpdateSourceTrigger=PropertyChanged}"
                                         FontFamily="Consolas" FontSize="11.5"
                                         AcceptsReturn="True" TextWrapping="NoWrap"
                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                         MinHeight="160"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ Tab 7: 终端 ============ -->
            <TabItem Header="{x:Static res:Strings.SysDbg_TabTerminal}">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="{x:Static res:Strings.SysDbg_Run}" Style="{StaticResource BtnAccent}" Margin="8,0,0,0"
                                Command="{Binding RunTerminalCommand}"/>
                        <TextBox Text="{Binding TerminalCommand, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="Consolas" VerticalContentAlignment="Center"
                                 KeyDown="Terminal_KeyDown"/>
                    </DockPanel>

                    <TextBox Grid.Row="1" Text="{Binding TerminalOutput, Mode=OneWay}" IsReadOnly="True"
                             FontFamily="Consolas" FontSize="12"
                             AcceptsReturn="True" TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             Background="{StaticResource Bg.Sunken}"/>

                    <TextBlock Grid.Row="2" Text="{Binding Status}" Margin="2,8,0,0"
                               FontSize="11.5" Foreground="{StaticResource Text.Secondary}"/>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- 页面状态栏 -->
        <TextBlock Grid.Row="1" Text="{Binding Status}" Margin="2,8,0,0"
                   FontSize="11.5" Foreground="{StaticResource Text.Secondary}"/>
    </Grid>
</UserControl>
