<UserControl x:Class="AdbToolkit.Views.SysDebugView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" Background="Transparent" BorderThickness="0"
                    SelectionChanged="Tabs_SelectionChanged">

            <!-- ============ Tab 1: 系统设置 ============ -->
            <TabItem Header="系统设置">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="330"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12" Margin="0,0,12,0">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <Button DockPanel.Dock="Right" Content="搜索" Style="{StaticResource BtnTool}" Margin="8,0,0,0"
                                        Command="{Binding SearchSettingsCommand}"/>
                                <ComboBox ItemsSource="{Binding Namespaces}"
                                          SelectedItem="{Binding SelectedNamespace}" Width="90"/>
                                <TextBox Text="{Binding SettingsSearch, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="8,0,0,0" VerticalContentAlignment="Center"/>
                            </DockPanel>
                            <ListView ItemsSource="{Binding SettingsItems}" FontSize="12" BorderThickness="0"
                                      FontFamily="Consolas">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="键" Width="240"
                                                        DisplayMemberBinding="{Binding Key}"/>
                                        <GridViewColumn Header="值" Width="420"
                                                        DisplayMemberBinding="{Binding Value}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource Card}" Padding="14" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="读写单项（get / put / delete）" Style="{StaticResource CardTitle}"/>
                            <TextBlock Text="键名" FontSize="11.5" Foreground="{StaticResource Text.Secondary}"/>
                            <TextBox Text="{Binding SettingKey, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8"/>
                            <TextBlock Text="值" FontSize="11.5" Foreground="{StaticResource Text.Secondary}"/>
                            <TextBox Text="{Binding SettingValue, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8"/>
                            <WrapPanel>
                                <Button Content="读取" Command="{Binding GetSettingCommand}"/>
                                <Button Content="写入" Style="{StaticResource BtnAccent}" Margin="6,0,0,0"
                                        Command="{Binding PutSettingCommand}"/>
                                <Button Content="删除" Style="{StaticResource BtnDanger}" Margin="6,0,0,0"
                                        Command="{Binding DeleteSettingCommand}"/>
                            </WrapPanel>
                            <TextBlock FontSize="10.5" Foreground="{StaticResource Text.Secondary}"
                                       Margin="0,10,0,0" TextWrapping="Wrap"
                                       Text="示例：把 ntp_server 切到国内源 —— 键 ntp_server，值 cn.ntp.org.cn，命名空间 global。修改系统设置可能影响设备行为，请自行评估。"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ============ Tab 2: 属性 getprop ============ -->
            <TabItem x:Name="PropsTabItem" Header="属性 getprop">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="330"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12" Margin="0,0,12,0">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                                <TextBox x:Name="PropSearchBox"
                                         Text="{Binding PropSearch, UpdateSourceTrigger=PropertyChanged}"
                                         VerticalContentAlignment="Center"
                                         KeyDown="PropSearch_KeyDown"/>
                                <Popup IsOpen="{Binding PropSuggestionsOpen, Mode=TwoWay}"
                                       PlacementTarget="{Binding ElementName=PropSearchBox}"
                                       Placement="Bottom"
                                       StaysOpen="False"
                                       AllowsTransparency="True"
                                       PopupAnimation="Fade">
                                    <Border Background="White"
                                            BorderBrush="{StaticResource Border}" BorderThickness="1"
                                            CornerRadius="4" MinWidth="320" MaxHeight="240"
                                            Margin="0,2,0,0">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.18"/>
                                        </Border.Effect>
                                        <ListBox x:Name="PropSuggestionsList"
                                                 ItemsSource="{Binding PropSuggestions}"
                                                 BorderThickness="0" Padding="4"
                                                 FontFamily="Consolas" FontSize="12"
                                                 PreviewMouseLeftButtonUp="PropSuggestions_Click"/>
                                    </Border>
                                </Popup>
                            </Grid>
                            <TextBlock DockPanel.Dock="Bottom" FontSize="10.5"
                                       Foreground="{StaticResource Text.Secondary}" Margin="0,6,0,0"
                                       Text="输入即时过滤属性名；Enter 采纳第一条提示，Esc 关闭提示；点击提示直接精确过滤。"/>
                            <ListView x:Name="PropsList"
                                      ItemsSource="{Binding Props}"
                                      SelectedItem="{Binding SelectedProp, Mode=TwoWay}"
                                      FontSize="12" BorderThickness="0"
                                      FontFamily="Consolas"
                                      PreviewMouseRightButtonDown="PropsList_PreviewMouseRightButtonDown"
                                      ContextMenuOpening="PropsList_ContextMenuOpening">
                                <ListView.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="修改值..." Click="EditProp_Click"/>
                                        <MenuItem Header="复制属性名" Click="CopyPropKey_Click"/>
                                        <MenuItem Header="复制值" Click="CopyPropValue_Click"/>
                                    </ContextMenu>
                                </ListView.ContextMenu>
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="属性" Width="320"
                                                        DisplayMemberBinding="{Binding Key}"/>
                                        <GridViewColumn Header="值" Width="420"
                                                        DisplayMemberBinding="{Binding Value}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource Card}" Padding="14" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="常用属性快查" Style="{StaticResource CardTitle}"/>
                            <ItemsControl FontSize="12" Foreground="{StaticResource Text.Secondary}">
                                <TextBlock Text="dalvik.vm.heapgrowthlimit — 单应用堆上限"/>
                                <TextBlock Text="dalvik.vm.heapstartsize — 初始堆大小" Margin="0,4,0,0"/>
                                <TextBlock Text="dalvik.vm.heapsize — 虚拟机最大堆" Margin="0,4,0,0"/>
                                <TextBlock Text="ro.config.low_ram — 是否低内存设备" Margin="0,4,0,0"/>
                                <TextBlock Text="persist.sys.usb.config — USB 配置" Margin="0,4,0,0"/>
                                <TextBlock Text="service.adb.tcp.port — 网络调试端口" Margin="0,4,0,0"/>
                                <TextBlock Text="ro.build.version.security_patch — 安全补丁" Margin="0,4,0,0"/>
                                <TextBlock Text="ro.hardware / ro.board.platform — 平台" Margin="0,4,0,0"/>
                            </ItemsControl>
                            <TextBlock FontSize="10.5" Foreground="{StaticResource Text.Secondary}"
                                       Margin="0,10,0,0" TextWrapping="Wrap"
                                       Text="在左侧搜索框输入关键字即可过滤，例如 heapgrowthlimit。"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ============ Tab 3: Intent 构造器 ============ -->
            <TabItem Header="Intent 构造器">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="360"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="16" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="构造 am start 参数" Style="{StaticResource CardTitle}"/>
                            <TextBlock Text="Action（如 android.intent.action.VIEW）" FontSize="11.5"
                                       Foreground="{StaticResource Text.Secondary}"/>
                            <TextBox Text="{Binding IntentAction, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8"/>
                            <TextBlock Text="URI / Data（如 https://example.com/page）" FontSize="11.5"
                                       Foreground="{StaticResource Text.Secondary}"/>
                            <TextBox Text="{Binding IntentUri, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8"/>
                            <TextBlock Text="Component（如 com.android.settings/.Settings）" FontSize="11.5"
                                       Foreground="{StaticResource Text.Secondary}"/>
                            <TextBox Text="{Binding IntentComponent, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8"/>
                            <TextBlock Text="Extras（每行一条：类型:键=值，类型支持 es/ei/el/ez/eb）" FontSize="11.5"
                                       Foreground="{StaticResource Text.Secondary}"/>
                            <TextBox Text="{Binding IntentExtras, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" MinHeight="70"
                                     VerticalScrollBarVisibility="Auto" Margin="0,4,0,8"/>
                            <Button Content="发送 Intent" Style="{StaticResource BtnAccent}"
                                    HorizontalAlignment="Left" Command="{Binding RunIntentCommand}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource Card}" Padding="14">
                        <StackPanel>
                            <TextBlock Text="输出 / 广播用法" Style="{StaticResource CardTitle}"/>
                            <TextBox Text="{Binding IntentOutput, Mode=OneWay}" IsReadOnly="True"
                                     FontFamily="Consolas" FontSize="11.5"
                                     AcceptsReturn="True" TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                     MinHeight="200" BorderThickness="0"
                                     Background="{StaticResource Bg.Sunken}"/>
                            <TextBlock FontSize="10.5" Foreground="{StaticResource Text.Secondary}"
                                       Margin="0,10,0,0" TextWrapping="Wrap"
                                       Text="发广播示例（可在终端标签页执行）：am broadcast -a com.cnd.update.system&#x0a;启动服务：am startservice -n 包/服务名"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ============ Tab 4: 设置页面 ============ -->
            <TabItem Header="设置页面">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                    <StackPanel>
                        <!-- 应用详情直达 -->
                        <Border Style="{StaticResource Card}" Padding="16">
                            <StackPanel>
                                <TextBlock Text="应用详情直达" Style="{StaticResource CardTitle}"/>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="打开" Style="{StaticResource BtnAccent}"
                                            Margin="8,0,0,0"
                                            Command="{Binding OpenAppDetailsByPackageCommand}"/>
                                    <TextBox Text="{Binding SettingsPkgInput, UpdateSourceTrigger=PropertyChanged}"
                                             FontFamily="Consolas" VerticalContentAlignment="Center"/>
                                </DockPanel>
                                <TextBlock FontSize="10.5" Foreground="{StaticResource Text.Secondary}"
                                           Margin="0,8,0,0"
                                           Text="输入包名直达该应用详情页（权限 / 存储 / 卸载入口），例如 com.example.app。"/>
                            </StackPanel>
                        </Border>

                        <!-- 通用 -->
                        <Border Style="{StaticResource Card}" Padding="16" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="系统与通用" Style="{StaticResource CardTitle}"/>
                                <ItemsControl ItemsSource="{Binding SettingsGeneral}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding Label}" Margin="0,0,8,8"
                                                    ToolTip="{Binding Action}"
                                                    Command="{Binding DataContext.OpenSettingsCommand,
                                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding Action}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- 应用与权限 -->
                        <Border Style="{StaticResource Card}" Padding="16" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="应用与权限" Style="{StaticResource CardTitle}"/>
                                <ItemsControl ItemsSource="{Binding SettingsApps}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding Label}" Margin="0,0,8,8"
                                                    ToolTip="{Binding Action}"
                                                    Command="{Binding DataContext.OpenSettingsCommand,
                                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding Action}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- 网络 -->
                        <Border Style="{StaticResource Card}" Padding="16" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="网络与连接" Style="{StaticResource CardTitle}"/>
                                <ItemsControl ItemsSource="{Binding SettingsNetwork}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding Label}" Margin="0,0,8,8"
                                                    ToolTip="{Binding Action}"
                                                    Command="{Binding DataContext.OpenSettingsCommand,
                                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding Action}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- 设备 -->
                        <Border Style="{StaticResource Card}" Padding="16" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="设备与显示" Style="{StaticResource CardTitle}"/>
                                <ItemsControl ItemsSource="{Binding SettingsDevice}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding Label}" Margin="0,0,8,8"
                                                    ToolTip="{Binding Action}"
                                                    Command="{Binding DataContext.OpenSettingsCommand,
                                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding Action}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <TextBlock FontSize="10.5" Foreground="{StaticResource Text.Secondary}"
                                   Margin="4,4,0,0"
                                   Text="点击即在设备上打开对应设置页（am start -a android.settings.*），个别页面名称因 ROM 定制可能略有差异。"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ Tab 5: 调试预设 ============ -->
            <TabItem Header="调试预设">
                <Border Style="{StaticResource Card}" Padding="16" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="一键预设开关（点击即执行）" Style="{StaticResource CardTitle}"/>
                        <ItemsControl ItemsSource="{Binding Presets}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="215" Margin="0,0,10,10"
                                            Background="{StaticResource Bg.Sunken}"
                                            BorderBrush="{StaticResource Divider}"
                                            BorderThickness="1" CornerRadius="6" Padding="10">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="12.5"/>
                                            <TextBlock Text="{Binding Description}" FontSize="10.5"
                                                       Foreground="{StaticResource Text.Secondary}"
                                                       TextWrapping="Wrap" Margin="0,2,0,6" MinHeight="28"/>
                                            <Button Content="执行" Style="{StaticResource BtnAccent}" Padding="14,4"
                                                    HorizontalAlignment="Left"
                                                    Command="{Binding DataContext.ApplyPresetCommand,
                                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="执行结果" Style="{StaticResource CardTitle}" Margin="0,10,0,4"/>
                        <TextBox Text="{Binding TerminalOutput, Mode=OneWay}" IsReadOnly="True"
                                 FontFamily="Consolas" FontSize="11.5"
                                 AcceptsReturn="True" TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 MinHeight="100" BorderThickness="0"
                                 Background="{StaticResource Bg.Sunken}"/>
                    </StackPanel>
                </Border>
            </TabItem>

            <!-- ============ Tab 6: SELinux 与高危操作 ============ -->
            <TabItem Header="SELinux / 高危">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                    <StackPanel>
                        <Border Style="{StaticResource Card}" Padding="16">
                            <StackPanel>
                                <TextBlock Text="SELinux（需要 root）" Style="{StaticResource CardTitle}"/>
                                <WrapPanel VerticalAlignment="Center">
                                    <TextBlock Text="当前状态：" VerticalAlignment="Center" FontSize="12.5"/>
                                    <TextBlock Text="{Binding EnforceState}" VerticalAlignment="Center"
                                               FontWeight="Bold" Margin="4,0,14,0"/>
                                    <Button Content="查看" Command="{Binding GetEnforceCommand}"/>
                                    <Button Content="Permissive (0)" Margin="8,0,0,0"
                                            Command="{Binding SetEnforceCommand}" CommandParameter="0"/>
                                    <Button Content="Enforcing (1)" Margin="8,0,0,0"
                                            Command="{Binding SetEnforceCommand}" CommandParameter="1"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Padding="16" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="ADB 网络调试持久化（root）" Style="{StaticResource CardTitle}"/>
                                <WrapPanel VerticalAlignment="Center">
                                    <TextBlock Text="端口" VerticalAlignment="Center" FontSize="12" Margin="0,0,6,0"/>
                                    <TextBox Text="{Binding PersistPort}" Width="70"/>
                                    <Button Content="写入并重启 adbd" Style="{StaticResource BtnAccent}" Margin="10,0,0,0"
                                            Command="{Binding PersistAdbCommand}"/>
                                </WrapPanel>
                                <TextBlock FontSize="10.5" Foreground="{StaticResource Text.Secondary}"
                                           Margin="0,8,0,0" TextWrapping="Wrap"
                                           Text="setprop service.adb.tcp.port + stop/start adbd，重启设备后 WiFi 调试端口依然生效（tcpip 方式重启即失效）。"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Padding="16" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="内核恐慌日志（pstore）" Style="{StaticResource CardTitle}"/>
                                <WrapPanel VerticalAlignment="Center">
                                    <Button Content="查看 /sys/fs/pstore" Command="{Binding ListPstoreCommand}"/>
                                    <Button Content="拉取全部到桌面" Style="{StaticResource BtnAccent}" Margin="8,0,0,0"
                                            Command="{Binding PullPstoreCommand}"/>
                                </WrapPanel>
                                <TextBox Text="{Binding PstoreList, Mode=OneWay}" IsReadOnly="True"
                                         FontFamily="Consolas" FontSize="11.5"
                                         AcceptsReturn="True" TextWrapping="NoWrap"
                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                         MinHeight="90" Margin="0,8,0,0"
                                         BorderThickness="0" Background="{StaticResource Bg.Sunken}"/>
                                <TextBlock FontSize="10.5" Foreground="{StaticResource Text.Secondary}"
                                           Margin="0,8,0,0"
                                           Text="console-ramoops-* 是上次复位前的内核控制台日志，排查死机/重启必看。"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Padding="16" Margin="0,12,0,0"
                                BorderBrush="#F3C2BD">
                            <StackPanel>
                                <TextBlock Text="build.prop 查看 / 编辑（高危，需 root）" Style="{StaticResource CardTitle}"
                                           Foreground="{StaticResource Status.Error}"/>
                                <WrapPanel VerticalAlignment="Center" Margin="0,0,0,8">
                                    <ComboBox Width="220"
                                              ItemsSource="{Binding PropFilePaths}"
                                              SelectedItem="{Binding PropFilePath}"/>
                                    <Button Content="读取" Margin="8,0,0,0" Command="{Binding ReadPropFileCommand}"/>
                                    <Button Content="保存写回..." Style="{StaticResource BtnDanger}" Margin="8,0,0,0"
                                            Command="{Binding SavePropFileCommand}"/>
                                </WrapPanel>
                                <TextBox Text="{Binding PropFileContent, UpdateSourceTrigger=PropertyChanged}"
                                         FontFamily="Consolas" FontSize="11.5"
                                         AcceptsReturn="True" TextWrapping="NoWrap"
                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                         MinHeight="160"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ Tab 7: 终端 ============ -->
            <TabItem Header="终端">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="执行" Style="{StaticResource BtnAccent}" Margin="8,0,0,0"
                                Command="{Binding RunTerminalCommand}"/>
                        <TextBox Text="{Binding TerminalCommand, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="Consolas" VerticalContentAlignment="Center"
                                 KeyDown="Terminal_KeyDown"/>
                    </DockPanel>

                    <TextBox Grid.Row="1" Text="{Binding TerminalOutput, Mode=OneWay}" IsReadOnly="True"
                             FontFamily="Consolas" FontSize="12"
                             AcceptsReturn="True" TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             Background="{StaticResource Bg.Sunken}"/>

                    <TextBlock Grid.Row="2" Text="{Binding Status}" Margin="2,8,0,0"
                               FontSize="11.5" Foreground="{StaticResource Text.Secondary}"/>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- 页面状态栏 -->
        <TextBlock Grid.Row="1" Text="{Binding Status}" Margin="2,8,0,0"
                   FontSize="11.5" Foreground="{StaticResource Text.Secondary}"/>
    </Grid>
</UserControl>
