<UserControl x:Class="AdbToolkit.Views.AppsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:AdbToolkit.Resources">

    <!-- 应用级隐式 TextBlock 样式不穿透 UserControl 模板边界，本地补一份保证文字跟随主题 -->
    <UserControl.Resources>
        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"/>
    </UserControl.Resources>

    <Grid AllowDrop="True" Drop="Page_Drop" DragOver="Page_DragOver">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ======= 工具栏 ======= -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,12">
            <WrapPanel VerticalAlignment="Center">
                <Button Content="{x:Static res:Strings.Apps_RefreshList}" Style="{StaticResource BtnAccent}"
                        Command="{Binding LoadCommand}"/>
                <Button Content="{x:Static res:Strings.Apps_InstallApk}" Margin="8,0,0,0"
                        Command="{Binding InstallCommand}"/>

                <CheckBox Content="{x:Static res:Strings.Apps_ShowSystem}" IsChecked="{Binding ShowSystem}"
                          VerticalAlignment="Center" Margin="16,0,0,0"/>
                <CheckBox Content="{x:Static res:Strings.Apps_KeepData}" IsChecked="{Binding KeepData}"
                          VerticalAlignment="Center" Margin="12,0,0,0"/>
                <CheckBox Content="{x:Static res:Strings.Apps_GrantPermissions}" IsChecked="{Binding GrantPermissions}"
                          VerticalAlignment="Center" Margin="12,0,0,0"/>

                <TextBlock Text="{x:Static res:Strings.Apps_Search}" VerticalAlignment="Center"
                           Margin="16,0,6,0" FontSize="12"
                           Foreground="{StaticResource Text.Secondary}"/>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Width="200"/>
            </WrapPanel>
        </Border>

        <!-- ======= 应用列表 ======= -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="4">
            <ListView x:Name="AppsList"
                      ItemsSource="{Binding AppsView}"
                      SelectedItem="{Binding SelectedApp, Mode=TwoWay}"
                      BorderThickness="0"
                      FontSize="12.5"
                      PreviewMouseRightButtonDown="AppsList_PreviewMouseRightButtonDown"
                      ContextMenuOpening="AppsList_ContextMenuOpening">
                <ListView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{x:Static res:Strings.Apps_MenuGetLabel}" Click="GetLabel_Click"/>
                        <MenuItem Header="{x:Static res:Strings.Apps_MenuDetail}" Click="ShowDetail_Click"/>
                        <Separator/>
                        <MenuItem Header="{x:Static res:Strings.Apps_MenuCopyLabel}" Click="CopyLabel_Click"/>
                        <MenuItem Header="{x:Static res:Strings.Apps_MenuCopyPkg}" Click="CopyPkg_Click"/>
                        <MenuItem Header="{x:Static res:Strings.Apps_MenuCopyPath}" Click="CopyPath_Click"/>
                        <MenuItem Header="{x:Static res:Strings.Apps_MenuExtractApk}" Click="ExtractApk_Click"/>
                        <Separator/>
                        <MenuItem Header="{x:Static res:Strings.Apps_MenuOpenSystemDetail}" Click="OpenSystemDetail_Click"/>
                        <MenuItem Header="{x:Static res:Strings.Apps_Uninstall}" Click="Uninstall_Click"/>
                    </ContextMenu>
                </ListView.ContextMenu>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="{x:Static res:Strings.Apps_ColAppName}" Width="180"
                                        DisplayMemberBinding="{Binding Label}"/>
                        <GridViewColumn Header="{x:Static res:Strings.DevMgr_Package}" Width="270"
                                        DisplayMemberBinding="{Binding Package}"/>
                        <GridViewColumn Header="{x:Static res:Strings.Apps_ColApkPath}" Width="450"
                                        DisplayMemberBinding="{Binding ApkPath}"/>
                        <GridViewColumn Header="{x:Static res:Strings.Apps_ColAction}" Width="90">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="{x:Static res:Strings.Apps_Uninstall}"
                                            Style="{StaticResource BtnDanger}"
                                            Padding="8,2" FontSize="11.5"
                                            Command="{Binding DataContext.UninstallCommand,
                                                RelativeSource={RelativeSource AncestorType=ListView}}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <!-- ======= 状态栏 ======= -->
        <TextBlock Grid.Row="2" Text="{Binding Status}" Margin="2,8,0,0"
                   FontSize="11.5" Foreground="{StaticResource Text.Secondary}"/>
    </Grid>
</UserControl>
