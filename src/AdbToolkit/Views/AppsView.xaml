<UserControl x:Class="AdbToolkit.Views.AppsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid AllowDrop="True" Drop="Page_Drop" DragOver="Page_DragOver">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ======= 工具栏 ======= -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,12">
            <WrapPanel VerticalAlignment="Center">
                <Button Content="刷新列表" Style="{StaticResource BtnAccent}"
                        Command="{Binding LoadCommand}"/>
                <Button Content="安装 APK（可多选）..." Margin="8,0,0,0"
                        Command="{Binding InstallCommand}"/>

                <CheckBox Content="显示系统应用" IsChecked="{Binding ShowSystem}"
                          VerticalAlignment="Center" Margin="16,0,0,0"/>
                <CheckBox Content="卸载时保留数据 (-k)" IsChecked="{Binding KeepData}"
                          VerticalAlignment="Center" Margin="12,0,0,0"/>
                <CheckBox Content="安装时自动授权 (-g)" IsChecked="{Binding GrantPermissions}"
                          VerticalAlignment="Center" Margin="12,0,0,0"/>

                <TextBlock Text="搜索" VerticalAlignment="Center"
                           Margin="16,0,6,0" FontSize="12"
                           Foreground="{StaticResource Text.Secondary}"/>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Width="200"/>
            </WrapPanel>
        </Border>

        <!-- ======= 应用列表 ======= -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="4">
            <ListView x:Name="AppsList"
                      ItemsSource="{Binding AppsView}"
                      SelectedItem="{Binding SelectedApp, Mode=TwoWay}"
                      BorderThickness="0"
                      FontSize="12.5"
                      PreviewMouseRightButtonDown="AppsList_PreviewMouseRightButtonDown"
                      ContextMenuOpening="AppsList_ContextMenuOpening">
                <ListView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="获取应用名（解析 APK）" Click="GetLabel_Click"/>
                        <MenuItem Header="应用详情..." Click="ShowDetail_Click"/>
                        <Separator/>
                        <MenuItem Header="复制应用名" Click="CopyLabel_Click"/>
                        <MenuItem Header="复制包名" Click="CopyPkg_Click"/>
                        <MenuItem Header="复制 APK 路径" Click="CopyPath_Click"/>
                        <MenuItem Header="提取 APK 到本地..." Click="ExtractApk_Click"/>
                        <Separator/>
                        <MenuItem Header="打开系统详情页" Click="OpenSystemDetail_Click"/>
                        <MenuItem Header="卸载" Click="Uninstall_Click"/>
                    </ContextMenu>
                </ListView.ContextMenu>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="应用名" Width="180"
                                        DisplayMemberBinding="{Binding Label}"/>
                        <GridViewColumn Header="包名" Width="270"
                                        DisplayMemberBinding="{Binding Package}"/>
                        <GridViewColumn Header="APK 路径" Width="450"
                                        DisplayMemberBinding="{Binding ApkPath}"/>
                        <GridViewColumn Header="操作" Width="90">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="卸载"
                                            Style="{StaticResource BtnDanger}"
                                            Padding="8,2" FontSize="11.5"
                                            Command="{Binding DataContext.UninstallCommand,
                                                RelativeSource={RelativeSource AncestorType=ListView}}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <!-- ======= 状态栏 ======= -->
        <TextBlock Grid.Row="2" Text="{Binding Status}" Margin="2,8,0,0"
                   FontSize="11.5" Foreground="{StaticResource Text.Secondary}"/>
    </Grid>
</UserControl>
