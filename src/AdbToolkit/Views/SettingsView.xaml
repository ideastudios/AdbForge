<UserControl x:Class="AdbToolkit.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:AdbToolkit.Resources">

    <!-- 应用级隐式 TextBlock 样式不穿透 UserControl 模板边界，本地补一份保证文字跟随主题 -->
    <UserControl.Resources>
        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="{x:Static res:Strings.Settings_AdbConfigTitle}" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="{x:Static res:Strings.Settings_AdbPathLabel}" FontSize="11.5"
                                   Foreground="{StaticResource Text.Secondary}" Margin="0,0,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding AdbPath, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="Consolas"/>
                            <Button Grid.Column="1" Content="{x:Static res:Strings.Settings_Browse}" Margin="8,0,0,0"
                                    Command="{Binding BrowseCommand}"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="{x:Static res:Strings.Common_Save}" Style="{StaticResource BtnAccent}"
                                    Command="{Binding SaveCommand}"/>
                            <Button Content="{x:Static res:Strings.Settings_TestAdb}" Margin="8,0,0,0"
                                    Command="{Binding TestCommand}"/>
                        </StackPanel>

                        <TextBlock Text="{x:Static res:Strings.Settings_Notes}" FontSize="12" FontWeight="SemiBold" Margin="0,16,0,4"/>
                        <TextBlock FontSize="11.5" TextWrapping="Wrap" LineHeight="19"
                                   Foreground="{StaticResource Text.Secondary}"
                                   Text="{x:Static res:Strings.Settings_NotesText}"/>
                    </StackPanel>
                </Border>

                <!-- 应用缓存清理 -->
                <Border Style="{StaticResource Card}" VerticalAlignment="Top" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="{x:Static res:Strings.Settings_CacheTitle}" Style="{StaticResource CardTitle}"/>
                        <TextBox Text="{Binding CacheInfoText, Mode=OneWay}"
                                 IsReadOnly="True"
                                 FontFamily="Consolas" FontSize="11.5"
                                 AcceptsReturn="True"
                                 MinHeight="58"
                                 BorderThickness="0"
                                 Background="{StaticResource Bg.Sunken}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="{x:Static res:Strings.Settings_RefreshStats}" Style="{StaticResource BtnTool}"
                                    Command="{Binding RefreshCacheCommand}"/>
                            <Button Content="{x:Static res:Strings.Settings_ClearPcCache}" Style="{StaticResource BtnAccent}" Margin="8,0,0,0"
                                    Command="{Binding ClearPcCacheCommand}"/>
                            <Button Content="{x:Static res:Strings.Settings_ClearDeviceFiles}" Style="{StaticResource BtnTool}" Margin="8,0,0,0"
                                    Command="{Binding ClearDeviceFilesCommand}"/>
                        </StackPanel>
                        <TextBlock FontSize="10.5" Foreground="{StaticResource Text.Secondary}"
                                   Margin="0,10,0,0" TextWrapping="Wrap"
                                   Text="{x:Static res:Strings.Settings_CacheHelpText}"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="0,0,0,0">
                <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="{x:Static res:Strings.Settings_TestResultTitle}" Style="{StaticResource CardTitle}"/>
                        <TextBox Text="{Binding TestResult, Mode=OneWay}"
                                 IsReadOnly="True"
                                 FontFamily="Consolas" FontSize="12"
                                 AcceptsReturn="True"
                                 TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 MinHeight="160"/>
                    </StackPanel>
                </Border>

                <!-- 外观与更新 -->
                <Border Style="{StaticResource Card}" VerticalAlignment="Top" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="{x:Static res:Strings.Settings_AppearanceTitle}" Style="{StaticResource CardTitle}"/>

                        <TextBlock Text="{x:Static res:Strings.Settings_ThemeLabel}" FontSize="11.5"
                                   Foreground="{StaticResource Text.Secondary}" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding Themes}"
                                  SelectedItem="{Binding SelectedTheme}"
                                  DisplayMemberPath="DisplayName"/>

                        <TextBlock Text="{x:Static res:Strings.Settings_LanguageLabel}" FontSize="11.5"
                                   Foreground="{StaticResource Text.Secondary}" Margin="0,10,0,4"/>
                        <ComboBox ItemsSource="{Binding Languages}"
                                  SelectedItem="{Binding SelectedLanguage}"
                                  DisplayMemberPath="DisplayName"/>

                        <CheckBox Content="{x:Static res:Strings.Settings_HideToTray}"
                                  IsChecked="{Binding HideToTrayOnClose}"
                                  Margin="0,12,0,0"/>

                        <TextBlock Text="{x:Static res:Strings.Settings_UpdateUrlLabel}" FontSize="11.5"
                                   Foreground="{StaticResource Text.Secondary}" Margin="0,10,0,4"/>
                        <TextBox Text="{Binding UpdateUrl, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="Consolas" Margin="0,0,0,8"/>

                        <StackPanel Orientation="Horizontal">
                            <Button Content="{x:Static res:Strings.Common_CheckUpdate}" Style="{StaticResource BtnAccent}"
                                    Command="{Binding CheckUpdateCommand}"/>
                            <Button Content="{x:Static res:Strings.Common_OpenLogsFolder}" Margin="8,0,0,0"
                                    Command="{Binding OpenLogsCommand}"/>
                            <TextBlock Text="{Binding VersionText}" VerticalAlignment="Center"
                                       Margin="12,0,0,0" FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource Accent}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 关于与隐私 -->
                <Border Style="{StaticResource Card}" VerticalAlignment="Top" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="{x:Static res:Strings.Settings_AboutTitle}" Style="{StaticResource CardTitle}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Image Source="/assets/logo.png" Width="40" Height="40"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   VerticalAlignment="Center"/>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{x:Static res:Strings.App_Title}" FontWeight="Bold" FontSize="14"
                                           Foreground="{StaticResource Text.Primary}"/>
                                <TextBlock Text="{Binding VersionText}" FontSize="11.5"
                                           Foreground="{StaticResource Accent}"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock FontSize="11.5" TextWrapping="Wrap" LineHeight="19"
                                   Foreground="{StaticResource Text.Secondary}"
                                   Text="{x:Static res:Strings.Settings_AboutText}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
