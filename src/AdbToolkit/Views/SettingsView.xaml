<UserControl x:Class="AdbToolkit.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="380"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,12,0">
            <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="ADB 环境配置" Style="{StaticResource CardTitle}"/>
                    <TextBlock Text="adb.exe 完整路径（留空则自动探测）" FontSize="11.5"
                               Foreground="{StaticResource Text.Secondary}" Margin="0,0,0,4"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding AdbPath, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="Consolas"/>
                        <Button Grid.Column="1" Content="浏览..." Margin="8,0,0,0"
                                Command="{Binding BrowseCommand}"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="保存" Style="{StaticResource BtnAccent}"
                                Command="{Binding SaveCommand}"/>
                        <Button Content="检测（adb version）" Margin="8,0,0,0"
                                Command="{Binding TestCommand}"/>
                    </StackPanel>

                    <TextBlock Text="说明" FontSize="12" FontWeight="SemiBold" Margin="0,16,0,4"/>
                    <TextBlock FontSize="11.5" TextWrapping="Wrap" LineHeight="19"
                               Foreground="{StaticResource Text.Secondary}"
                               Text="· 自动探测顺序：程序目录 platform-tools → %LOCALAPPDATA%\Android\Sdk\platform-tools → 系统 PATH&#x0a;· 多工具共用 adb 时可能因 server 端口 5037 冲突导致设备离线，本工具后续版本将支持独立 server 端口&#x0a;· 修改路径后建议点击「检测」确认 adb 可用"/>
                </StackPanel>
            </Border>

            <!-- 应用缓存清理 -->
            <Border Style="{StaticResource Card}" VerticalAlignment="Top" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="应用缓存" Style="{StaticResource CardTitle}"/>
                    <TextBox Text="{Binding CacheInfoText, Mode=OneWay}"
                             IsReadOnly="True"
                             FontFamily="Consolas" FontSize="11.5"
                             AcceptsReturn="True"
                             MinHeight="58"
                             BorderThickness="0"
                             Background="{StaticResource Bg.Sunken}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="刷新统计" Style="{StaticResource BtnTool}"
                                Command="{Binding RefreshCacheCommand}"/>
                        <Button Content="清除 PC 缓存" Style="{StaticResource BtnAccent}" Margin="8,0,0,0"
                                Command="{Binding ClearPcCacheCommand}"/>
                        <Button Content="清理设备端文件" Style="{StaticResource BtnTool}" Margin="8,0,0,0"
                                Command="{Binding ClearDeviceFilesCommand}"/>
                    </StackPanel>
                    <TextBlock FontSize="10.5" Foreground="{StaticResource Text.Secondary}"
                               Margin="0,10,0,0" TextWrapping="Wrap"
                               Text="PC 缓存 = 应用名/组件缓存（appmeta.json）+ 临时 APK 文件；设置（adb 路径等）不受影响。设备端文件 = 后台日志（adbtoolkit_logcat.txt）与录屏残留（adbtoolkit_record.mp4）。"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <StackPanel Grid.Column="1" Margin="0,0,0,0">
            <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="检测结果" Style="{StaticResource CardTitle}"/>
                    <TextBox Text="{Binding TestResult, Mode=OneWay}"
                             IsReadOnly="True"
                             FontFamily="Consolas" FontSize="12"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             MinHeight="160"/>
                </StackPanel>
            </Border>

            <!-- 外观与更新 -->
            <Border Style="{StaticResource Card}" VerticalAlignment="Top" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="外观与更新" Style="{StaticResource CardTitle}"/>

                    <TextBlock Text="主题（切换后重启应用生效）" FontSize="11.5"
                               Foreground="{StaticResource Text.Secondary}" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding Themes}"
                              SelectedItem="{Binding SelectedTheme}"/>

                    <TextBlock Text="更新服务器（托管版本描述 JSON 的 URL，留空不检查）" FontSize="11.5"
                               Foreground="{StaticResource Text.Secondary}" Margin="0,10,0,4"/>
                    <TextBox Text="{Binding UpdateUrl, UpdateSourceTrigger=PropertyChanged}"
                             FontFamily="Consolas" Margin="0,0,0,8"/>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="检查更新" Style="{StaticResource BtnAccent}"
                                Command="{Binding CheckUpdateCommand}"/>
                        <Button Content="打开日志文件夹" Margin="8,0,0,0"
                                Command="{Binding OpenLogsCommand}"/>
                        <TextBlock Text="{Binding VersionText}" VerticalAlignment="Center"
                                   Margin="12,0,0,0" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource Accent}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 关于与隐私 -->
            <Border Style="{StaticResource Card}" VerticalAlignment="Top" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="关于与隐私" Style="{StaticResource CardTitle}"/>
                    <TextBlock FontSize="11.5" TextWrapping="Wrap" LineHeight="19"
                               Foreground="{StaticResource Text.Secondary}"
                               Text="ADB 工具箱是一款面向 Android / AOSP 开发者的本地桌面工具。所有功能均通过本机 adb 与设备通信：&#x0a;· 不收集、不上传任何用户数据与设备信息&#x0a;· 唯一可能的网络访问是可选的更新检查（仅访问你在上方配置的服务器）&#x0a;· 运行日志仅保存在本机 %APPDATA%\AdbToolkit\logs，可在上方一键打开"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
