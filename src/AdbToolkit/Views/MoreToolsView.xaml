<UserControl x:Class="AdbToolkit.Views.MoreToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:AdbToolkit.Resources">

    <!-- 应用级隐式 TextBlock 样式不穿透 UserControl 模板边界，本地补一份保证文字跟随主题 -->
    <UserControl.Resources>
        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <WrapPanel>

            <!-- ======= 输入法 ======= -->
            <Border Width="385" Style="{StaticResource Card}" Padding="14" Margin="0,0,12,12">
                <StackPanel>
                    <TextBlock Text="{x:Static res:Strings.More_ImeTitle}" Style="{StaticResource CardTitle}"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="{x:Static res:Strings.More_ImeSwitch}" Style="{StaticResource BtnAccent}" Margin="8,0,0,0"
                                Command="{Binding ImeSetCommand}"/>
                        <ComboBox ItemsSource="{Binding Imes}" SelectedItem="{Binding SelectedIme}"
                                  VerticalContentAlignment="Center"/>
                    </DockPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="{x:Static res:Strings.Apps_RefreshList}" Style="{StaticResource BtnTool}" Command="{Binding ImeRefreshCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ======= 通知测试 ======= -->
            <Border Width="385" Style="{StaticResource Card}" Padding="14" Margin="0,0,12,12">
                <StackPanel>
                    <TextBlock Text="{x:Static res:Strings.More_NotifyTitle}" Style="{StaticResource CardTitle}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Static res:Strings.More_NotifyLabelTitle}" VerticalAlignment="Center" FontSize="12"/>
                        <TextBox Grid.Column="1" Text="{Binding NotifyTitle}" Margin="0,0,8,0"/>
                        <TextBlock Grid.Column="2" Text="Tag" VerticalAlignment="Center" FontSize="12"/>
                        <TextBox Grid.Column="3" Text="{Binding NotifyTag}"/>
                    </Grid>
                    <TextBox Text="{Binding NotifyContent}" Margin="0,8,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="{x:Static res:Strings.More_NotifySend}" Style="{StaticResource BtnAccent}"
                                Command="{Binding NotifyPostCommand}"/>
                        <Button Content="{x:Static res:Strings.More_NotifyView}" Margin="8,0,0,0"
                                Command="{Binding NotifyViewCommand}"/>
                    </StackPanel>
                    <TextBox Text="{Binding NotifyOutput, Mode=OneWay}" IsReadOnly="True"
                             FontFamily="Consolas" FontSize="10.5"
                             AcceptsReturn="True" TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             MinHeight="60" MaxHeight="140" Margin="0,8,0,0"
                             BorderThickness="0" Background="{StaticResource Bg.Sunken}"/>
                </StackPanel>
            </Border>

            <!-- ======= 代理 ======= -->
            <Border Width="385" Style="{StaticResource Card}" Padding="14" Margin="0,0,12,12">
                <StackPanel>
                    <TextBlock Text="{x:Static res:Strings.More_ProxyTitle}" Style="{StaticResource CardTitle}"/>
                    <TextBlock Text="{Binding ProxyCurrentDisplay}" FontSize="12"
                               Foreground="{StaticResource Text.Secondary}"/>
                    <DockPanel Margin="0,8,0,0">
                        <TextBlock DockPanel.Dock="Left" Text="host:port" VerticalAlignment="Center"
                                   FontSize="12" Margin="0,0,6,0"/>
                        <TextBox Text="{Binding ProxyTarget, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="Consolas"/>
                    </DockPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="{x:Static res:Strings.More_ProxySet}" Style="{StaticResource BtnAccent}"
                                Command="{Binding ProxySetCommand}"/>
                        <Button Content="{x:Static res:Strings.More_ProxyClear}" Style="{StaticResource BtnDanger}" Margin="8,0,0,0"
                                Command="{Binding ProxyClearCommand}"/>
                    </StackPanel>
                    <TextBlock FontSize="10.5" Foreground="{StaticResource Text.Secondary}"
                               Margin="0,8,0,0"
                               Text="{x:Static res:Strings.More_ProxyHelp}"/>
                </StackPanel>
            </Border>

            <!-- ======= 多用户 ======= -->
            <Border Width="385" Style="{StaticResource Card}" Padding="14" Margin="0,0,12,12">
                <StackPanel>
                    <TextBlock Text="{x:Static res:Strings.More_UsersTitle}" Style="{StaticResource CardTitle}"/>
                    <ListBox ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUserText}"
                             MinHeight="70" FontSize="11.5" FontFamily="Consolas" BorderThickness="0"/>
                    <DockPanel Margin="0,6,0,0">
                        <Button DockPanel.Dock="Right" Content="{x:Static res:Strings.More_UserDeleteSelected}" Style="{StaticResource BtnDanger}" Margin="6,0,0,0"
                                Command="{Binding UserRemoveCommand}"/>
                        <Button DockPanel.Dock="Right" Content="{x:Static res:Strings.More_UserCreate}" Margin="6,0,0,0"
                                Command="{Binding UserCreateCommand}"/>
                        <TextBox Text="{Binding NewUserName, UpdateSourceTrigger=PropertyChanged}"/>
                    </DockPanel>
                    <Button Content="{x:Static res:Strings.More_UserRefreshList}" Style="{StaticResource BtnTool}" Margin="0,8,0,0"
                            HorizontalAlignment="Left" Command="{Binding UserRefreshCommand}"/>
                </StackPanel>
            </Border>

            <!-- ======= 权限 ======= -->
            <Border Width="385" Style="{StaticResource Card}" Padding="14" Margin="0,0,12,12">
                <StackPanel>
                    <TextBlock Text="{x:Static res:Strings.More_PermTitle}" Style="{StaticResource CardTitle}"/>
                    <TextBox Text="{Binding PermPackage, UpdateSourceTrigger=PropertyChanged}"
                             FontFamily="Consolas"/>
                    <TextBox Text="{Binding PermName, UpdateSourceTrigger=PropertyChanged}"
                             FontFamily="Consolas" Margin="0,6,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="{x:Static res:Strings.More_PermGrant}" Style="{StaticResource BtnAccent}"
                                Command="{Binding PermissionGrantCommand}" CommandParameter="grant"/>
                        <Button Content="{x:Static res:Strings.More_PermRevoke}" Style="{StaticResource BtnDanger}" Margin="8,0,0,0"
                                Command="{Binding PermissionGrantCommand}" CommandParameter="revoke"/>
                    </StackPanel>
                    <TextBlock FontSize="10.5" Foreground="{StaticResource Text.Secondary}"
                               Margin="0,8,0,0" TextWrapping="Wrap"
                               Text="{x:Static res:Strings.More_PermHelp}"/>
                </StackPanel>
            </Border>

            <!-- ======= Bugreport ======= -->
            <Border Width="385" Style="{StaticResource Card}" Padding="14" Margin="0,0,12,12">
                <StackPanel>
                    <TextBlock Text="{x:Static res:Strings.More_BugreportTitle}" Style="{StaticResource CardTitle}"/>
                    <Button Content="{x:Static res:Strings.More_BugreportCollect}" Style="{StaticResource BtnAccent}"
                            HorizontalAlignment="Left" Command="{Binding BugreportCommand}"/>
                    <TextBox Text="{Binding BugreportPath, Mode=OneWay}" IsReadOnly="True"
                             FontFamily="Consolas" FontSize="10.5" Margin="0,8,0,0"
                             BorderThickness="0" Background="Transparent" TextWrapping="Wrap"/>
                    <Button Content="{x:Static res:Strings.More_BugreportOpenFolder}" Style="{StaticResource BtnTool}" Margin="0,4,0,0"
                            HorizontalAlignment="Left" Command="{Binding OpenBugreportFolderCommand}"/>
                </StackPanel>
            </Border>

            <!-- ======= ADB Server ======= -->
            <Border Width="385" Style="{StaticResource Card}" Padding="14" Margin="0,0,12,12">
                <StackPanel>
                    <TextBlock Text="{x:Static res:Strings.More_ServerTitle}" Style="{StaticResource CardTitle}"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="kill-server" Command="{Binding ServerKillCommand}"/>
                        <Button Content="start-server" Style="{StaticResource BtnAccent}" Margin="8,0,0,0"
                                Command="{Binding ServerStartCommand}"/>
                    </StackPanel>
                    <TextBlock FontSize="10.5" Foreground="{StaticResource Text.Secondary}"
                               Margin="0,8,0,0" TextWrapping="Wrap"
                               Text="{x:Static res:Strings.More_ServerHelp}"/>
                </StackPanel>
            </Border>

            <!-- ======= Sideload ======= -->
            <Border Width="385" Style="{StaticResource Card}" Padding="14" Margin="0,0,12,12"
                    BorderBrush="{StaticResource Danger.Border}">
                <StackPanel>
                    <TextBlock Text="{x:Static res:Strings.More_SideloadTitle}" Style="{StaticResource CardTitle}"
                               Foreground="{StaticResource Status.Error}"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="{x:Static res:Strings.More_SideloadPick}" Margin="8,0,0,0" Click="PickZip_Click"/>
                        <TextBox Text="{Binding SideloadZip, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="Consolas"/>
                    </DockPanel>
                    <Button Content="{x:Static res:Strings.More_SideloadRun}" Style="{StaticResource BtnDanger}" Margin="0,8,0,0"
                            HorizontalAlignment="Left" Command="{Binding SideloadCommand}"/>
                </StackPanel>
            </Border>

            <!-- ======= 设备端后台日志 ======= -->
            <Border Width="385" Style="{StaticResource Card}" Padding="14" Margin="0,0,12,12">
                <StackPanel>
                    <TextBlock Text="{x:Static res:Strings.More_DeviceLogTitle}" Style="{StaticResource CardTitle}"/>
                    <WrapPanel VerticalAlignment="Center">
                        <TextBlock Text="Buffer" VerticalAlignment="Center" FontSize="12" Margin="0,0,6,0"/>
                        <ComboBox ItemsSource="{Binding LogBuffers}" SelectedItem="{Binding SelectedLogBuffer}" Width="90"/>
                        <Button Content="{x:Static res:Strings.More_DeviceLogStart}" Style="{StaticResource BtnAccent}" Margin="10,0,0,0"
                                Command="{Binding LogBufStartCommand}"/>
                        <Button Content="{x:Static res:Strings.Logcat_Stop}" Margin="6,0,0,0" Command="{Binding LogBufStopCommand}"/>
                        <Button Content="{x:Static res:Strings.More_DeviceLogPull}" Margin="6,0,0,0" Command="{Binding LogBufPullCommand}"/>
                    </WrapPanel>
                    <TextBlock FontSize="10.5" Foreground="{StaticResource Text.Secondary}"
                               Margin="0,8,0,0" TextWrapping="Wrap"
                               Text="{x:Static res:Strings.More_DeviceLogHelp}"/>
                </StackPanel>
            </Border>

        </WrapPanel>
    </ScrollViewer>
</UserControl>
