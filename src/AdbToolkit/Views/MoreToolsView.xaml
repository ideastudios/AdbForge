<UserControl x:Class="AdbToolkit.Views.MoreToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <WrapPanel>

            <!-- ======= 输入法 ======= -->
            <Border Width="385" Style="{StaticResource Card}" Padding="14" Margin="0,0,12,12">
                <StackPanel>
                    <TextBlock Text="输入法切换" Style="{StaticResource CardTitle}"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="切换" Style="{StaticResource BtnAccent}" Margin="8,0,0,0"
                                Command="{Binding ImeSetCommand}"/>
                        <ComboBox ItemsSource="{Binding Imes}" SelectedItem="{Binding SelectedIme}"
                                  VerticalContentAlignment="Center"/>
                    </DockPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="刷新列表" Style="{StaticResource BtnTool}" Command="{Binding ImeRefreshCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ======= 通知测试 ======= -->
            <Border Width="385" Style="{StaticResource Card}" Padding="14" Margin="0,0,12,12">
                <StackPanel>
                    <TextBlock Text="通知测试器" Style="{StaticResource CardTitle}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="标题" VerticalAlignment="Center" FontSize="12"/>
                        <TextBox Grid.Column="1" Text="{Binding NotifyTitle}" Margin="0,0,8,0"/>
                        <TextBlock Grid.Column="2" Text="Tag" VerticalAlignment="Center" FontSize="12"/>
                        <TextBox Grid.Column="3" Text="{Binding NotifyTag}"/>
                    </Grid>
                    <TextBox Text="{Binding NotifyContent}" Margin="0,8,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="发送测试通知" Style="{StaticResource BtnAccent}"
                                Command="{Binding NotifyPostCommand}"/>
                        <Button Content="查看通知列表" Margin="8,0,0,0"
                                Command="{Binding NotifyViewCommand}"/>
                    </StackPanel>
                    <TextBox Text="{Binding NotifyOutput, Mode=OneWay}" IsReadOnly="True"
                             FontFamily="Consolas" FontSize="10.5"
                             AcceptsReturn="True" TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             MinHeight="60" MaxHeight="140" Margin="0,8,0,0"
                             BorderThickness="0" Background="{StaticResource Bg.Sunken}"/>
                </StackPanel>
            </Border>

            <!-- ======= 代理 ======= -->
            <Border Width="385" Style="{StaticResource Card}" Padding="14" Margin="0,0,12,12">
                <StackPanel>
                    <TextBlock Text="设备全局代理" Style="{StaticResource CardTitle}"/>
                    <TextBlock Text="{Binding ProxyCurrent, StringFormat=当前：{0}}" FontSize="12"
                               Foreground="{StaticResource Text.Secondary}"/>
                    <DockPanel Margin="0,8,0,0">
                        <TextBlock DockPanel.Dock="Left" Text="host:port" VerticalAlignment="Center"
                                   FontSize="12" Margin="0,0,6,0"/>
                        <TextBox Text="{Binding ProxyTarget, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="Consolas"/>
                    </DockPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="设置代理" Style="{StaticResource BtnAccent}"
                                Command="{Binding ProxySetCommand}"/>
                        <Button Content="清除代理" Style="{StaticResource BtnDanger}" Margin="8,0,0,0"
                                Command="{Binding ProxyClearCommand}"/>
                    </StackPanel>
                    <TextBlock FontSize="10.5" Foreground="{StaticResource Text.Secondary}"
                               Margin="0,8,0,0"
                               Text="配合 PC 抓包工具使用，例如 192.168.1.100:8888。"/>
                </StackPanel>
            </Border>

            <!-- ======= 多用户 ======= -->
            <Border Width="385" Style="{StaticResource Card}" Padding="14" Margin="0,0,12,12">
                <StackPanel>
                    <TextBlock Text="多用户调试" Style="{StaticResource CardTitle}"/>
                    <ListBox ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUserText}"
                             MinHeight="70" FontSize="11.5" FontFamily="Consolas" BorderThickness="0"/>
                    <DockPanel Margin="0,6,0,0">
                        <Button DockPanel.Dock="Right" Content="删除选中" Style="{StaticResource BtnDanger}" Margin="6,0,0,0"
                                Command="{Binding UserRemoveCommand}"/>
                        <Button DockPanel.Dock="Right" Content="创建" Margin="6,0,0,0"
                                Command="{Binding UserCreateCommand}"/>
                        <TextBox Text="{Binding NewUserName, UpdateSourceTrigger=PropertyChanged}"/>
                    </DockPanel>
                    <Button Content="刷新用户列表" Style="{StaticResource BtnTool}" Margin="0,8,0,0"
                            HorizontalAlignment="Left" Command="{Binding UserRefreshCommand}"/>
                </StackPanel>
            </Border>

            <!-- ======= 权限 ======= -->
            <Border Width="385" Style="{StaticResource Card}" Padding="14" Margin="0,0,12,12">
                <StackPanel>
                    <TextBlock Text="运行时权限授予 / 撤销" Style="{StaticResource CardTitle}"/>
                    <TextBox Text="{Binding PermPackage, UpdateSourceTrigger=PropertyChanged}"
                             FontFamily="Consolas"/>
                    <TextBox Text="{Binding PermName, UpdateSourceTrigger=PropertyChanged}"
                             FontFamily="Consolas" Margin="0,6,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="授予 grant" Style="{StaticResource BtnAccent}"
                                Command="{Binding PermissionGrantCommand}" CommandParameter="grant"/>
                        <Button Content="撤销 revoke" Style="{StaticResource BtnDanger}" Margin="8,0,0,0"
                                Command="{Binding PermissionGrantCommand}" CommandParameter="revoke"/>
                    </StackPanel>
                    <TextBlock FontSize="10.5" Foreground="{StaticResource Text.Secondary}"
                               Margin="0,8,0,0" TextWrapping="Wrap"
                               Text="示例包名 com.example.app，权限 android.permission.CAMERA。"/>
                </StackPanel>
            </Border>

            <!-- ======= Bugreport ======= -->
            <Border Width="385" Style="{StaticResource Card}" Padding="14" Margin="0,0,12,12">
                <StackPanel>
                    <TextBlock Text="Bugreport 采集" Style="{StaticResource CardTitle}"/>
                    <Button Content="一键采集（1-3 分钟）" Style="{StaticResource BtnAccent}"
                            HorizontalAlignment="Left" Command="{Binding BugreportCommand}"/>
                    <TextBox Text="{Binding BugreportPath, Mode=OneWay}" IsReadOnly="True"
                             FontFamily="Consolas" FontSize="10.5" Margin="0,8,0,0"
                             BorderThickness="0" Background="Transparent" TextWrapping="Wrap"/>
                    <Button Content="打开保存目录" Style="{StaticResource BtnTool}" Margin="0,4,0,0"
                            HorizontalAlignment="Left" Command="{Binding OpenBugreportFolderCommand}"/>
                </StackPanel>
            </Border>

            <!-- ======= ADB Server ======= -->
            <Border Width="385" Style="{StaticResource Card}" Padding="14" Margin="0,0,12,12">
                <StackPanel>
                    <TextBlock Text="ADB Server 管理" Style="{StaticResource CardTitle}"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="kill-server" Command="{Binding ServerKillCommand}"/>
                        <Button Content="start-server" Style="{StaticResource BtnAccent}" Margin="8,0,0,0"
                                Command="{Binding ServerStartCommand}"/>
                    </StackPanel>
                    <TextBlock FontSize="10.5" Foreground="{StaticResource Text.Secondary}"
                               Margin="0,8,0,0" TextWrapping="Wrap"
                               Text="设备持续 offline 时可尝试重启 server；多个工具争用 5037 端口也会导致离线。"/>
                </StackPanel>
            </Border>

            <!-- ======= Sideload ======= -->
            <Border Width="385" Style="{StaticResource Card}" Padding="14" Margin="0,0,12,12"
                    BorderBrush="#F3C2BD">
                <StackPanel>
                    <TextBlock Text="Sideload 刷 OTA（高危）" Style="{StaticResource CardTitle}"
                               Foreground="{StaticResource Status.Error}"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="选择..." Margin="8,0,0,0" Click="PickZip_Click"/>
                        <TextBox Text="{Binding SideloadZip, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="Consolas"/>
                    </DockPanel>
                    <Button Content="重启到 Sideload 并推送" Style="{StaticResource BtnDanger}" Margin="0,8,0,0"
                            HorizontalAlignment="Left" Command="{Binding SideloadCommand}"/>
                </StackPanel>
            </Border>

            <!-- ======= 设备端后台日志 ======= -->
            <Border Width="385" Style="{StaticResource Card}" Padding="14" Margin="0,0,12,12">
                <StackPanel>
                    <TextBlock Text="设备端后台日志（拔线采集）" Style="{StaticResource CardTitle}"/>
                    <WrapPanel VerticalAlignment="Center">
                        <TextBlock Text="Buffer" VerticalAlignment="Center" FontSize="12" Margin="0,0,6,0"/>
                        <ComboBox ItemsSource="{Binding LogBuffers}" SelectedItem="{Binding SelectedLogBuffer}" Width="90"/>
                        <Button Content="启动" Style="{StaticResource BtnAccent}" Margin="10,0,0,0"
                                Command="{Binding LogBufStartCommand}"/>
                        <Button Content="停止" Margin="6,0,0,0" Command="{Binding LogBufStopCommand}"/>
                        <Button Content="拉取日志" Margin="6,0,0,0" Command="{Binding LogBufPullCommand}"/>
                    </WrapPanel>
                    <TextBlock FontSize="10.5" Foreground="{StaticResource Text.Secondary}"
                               Margin="0,8,0,0" TextWrapping="Wrap"
                               Text="在设备上以 nohup 方式后台写 /sdcard/adbtoolkit_logcat.txt，适合老化测试、拔线长跑场景，回到 PC 后一键拉取。"/>
                </StackPanel>
            </Border>

        </WrapPanel>
    </ScrollViewer>
</UserControl>
