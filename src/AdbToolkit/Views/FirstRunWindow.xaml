<Window x:Class="AdbToolkit.Views.FirstRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="欢迎使用 ADB 工具箱"
        Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource Bg.Window}">
    <StackPanel Margin="20">
        <TextBlock Text="欢迎使用 ADB 工具箱" FontSize="19" FontWeight="Bold"
                   Foreground="{StaticResource Accent}" Margin="0,0,0,6"/>
        <TextBlock Text="面向 Android / AOSP 开发者的 Windows 桌面工具，所有功能均通过本机 adb 与设备通信，不收集、不上传任何数据。"
                   FontSize="12" TextWrapping="Wrap" LineHeight="19"
                   Foreground="{StaticResource Text.Secondary}" Margin="0,0,0,14"/>

        <Border Style="{StaticResource Card}" Padding="14">
            <StackPanel>
                <TextBlock Text="① adb 环境" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBlock x:Name="AdbStatusText" FontFamily="Consolas" FontSize="12"
                           TextWrapping="Wrap" Text="正在检测 adb ..."/>
                <TextBlock FontSize="10.5" Foreground="{StaticResource Text.Secondary}"
                           Margin="0,6,0,0" TextWrapping="Wrap"
                           Text="未检测到 adb 时，可在「设置」页手动指定 adb.exe 路径（如 D:\02.AndroidSdk\platform-tools\adb.exe）。"/>

                <TextBlock Text="② 使用建议" FontSize="12.5" FontWeight="SemiBold" Margin="0,12,0,4"/>
                <TextBlock FontSize="11.5" Foreground="{StaticResource Text.Secondary}"
                           TextWrapping="Wrap" LineHeight="18"
                           Text="· 插入设备后顶栏会自动出现，所有页面共用这个设备选择&#x0a;· 设置页可切换深色模式（重启生效）&#x0a;· 应用管理右键可提取 APK、查看任意应用的页面与权限"/>
            </StackPanel>
        </Border>

        <Button Content="开始使用" Style="{StaticResource BtnAccent}"
                HorizontalAlignment="Right" Margin="0,14,0,0" Padding="20,7"
                Click="Start_Click"/>
    </StackPanel>
</Window>
