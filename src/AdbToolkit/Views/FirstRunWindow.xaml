<Window x:Class="AdbToolkit.Views.FirstRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:AdbToolkit.Resources"
        Title="{x:Static res:Strings.FirstRun_Title}"
        Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource Bg.Window}">
    <StackPanel Margin="20">
        <Image Source="/assets/logo.png" Width="64" Height="64"
               HorizontalAlignment="Center"
               RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,0,8"/>
        <TextBlock Text="{x:Static res:Strings.FirstRun_Heading}" FontSize="19" FontWeight="Bold"
                   Foreground="{StaticResource Accent}" Margin="0,0,0,6"
                   TextAlignment="Center"/>
        <TextBlock Text="{x:Static res:Strings.FirstRun_Body}"
                   FontSize="12" TextWrapping="Wrap" LineHeight="19"
                   Foreground="{StaticResource Text.Secondary}" Margin="0,0,0,14"/>

        <Border Style="{StaticResource Card}" Padding="14">
            <StackPanel>
                <TextBlock Text="{x:Static res:Strings.FirstRun_StepAdb}" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBlock x:Name="AdbStatusText" FontFamily="Consolas" FontSize="12"
                           TextWrapping="Wrap" Text="{x:Static res:Strings.Main_DetectingAdb}"/>
                <TextBlock FontSize="10.5" Foreground="{StaticResource Text.Secondary}"
                           Margin="0,6,0,0" TextWrapping="Wrap"
                           Text="{x:Static res:Strings.FirstRun_AdbMissingHint}"/>

                <TextBlock Text="{x:Static res:Strings.FirstRun_StepTips}" FontSize="12.5" FontWeight="SemiBold" Margin="0,12,0,4"/>
                <TextBlock FontSize="11.5" Foreground="{StaticResource Text.Secondary}"
                           TextWrapping="Wrap" LineHeight="18"
                           Text="{x:Static res:Strings.FirstRun_TipsText}"/>
            </StackPanel>
        </Border>

        <Button Content="{x:Static res:Strings.FirstRun_GetStarted}" Style="{StaticResource BtnAccent}"
                HorizontalAlignment="Right" Margin="0,14,0,0" Padding="20,7"
                Click="Start_Click"/>
    </StackPanel>
</Window>
