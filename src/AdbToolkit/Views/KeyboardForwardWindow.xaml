<Window x:Class="AdbToolkit.Views.KeyboardForwardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="键盘透传（点击此窗口获得焦点后开始输入）"
        Width="640" Height="430"
        MinWidth="520" MinHeight="320"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg.Window}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="12">
            <StackPanel>
                <TextBlock Text="使用说明" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                <TextBlock FontSize="11.5" Foreground="{StaticResource Text.Secondary}"
                           TextWrapping="Wrap" LineHeight="18"
                           Text="· 点击本窗口任意位置获得焦点，按键即实时转发到主窗口顶部选中的设备&#x0a;· 打字（字母/数字/符号，含大小写）通过 input text 批量合并发送，长按自动重复&#x0a;· 回车 / 退格 / 方向键 / Tab / Esc / Home / End / PgUp / PgDn 通过 keyevent 发送&#x0a;· Ctrl / Alt + 按键通过 keycombination 发送（需 Android 11+，例如 Ctrl+A 全选、Ctrl+C 复制）&#x0a;· 中文无法通过 input text 输入（仅 ASCII），中文请用设备端剪贴板粘贴"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="4" Margin="0,12,0,0">
            <ListBox x:Name="LogList"
                     FontFamily="Consolas" FontSize="11.5"
                     BorderThickness="0" Background="Transparent"
                     VirtualizingPanel.ScrollUnit="Pixel"/>
        </Border>

        <TextBlock x:Name="StatusText" Grid.Row="2" Margin="2,8,0,0"
                   FontSize="11.5" Foreground="{StaticResource Text.Secondary}"
                   Text="等待按键…"/>
    </Grid>
</Window>
