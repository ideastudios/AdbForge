<Window x:Class="AdbToolkit.Views.KeyboardForwardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:AdbToolkit.Resources"
        Title="{x:Static res:Strings.Kb_Title}"
        Width="640" Height="430"
        MinWidth="520" MinHeight="320"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg.Window}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="12">
            <StackPanel>
                <TextBlock Text="{x:Static res:Strings.Kb_UsageTitle}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                <TextBlock FontSize="11.5" Foreground="{StaticResource Text.Secondary}"
                           TextWrapping="Wrap" LineHeight="18"
                           Text="{x:Static res:Strings.Kb_UsageText}"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="4" Margin="0,12,0,0">
            <ListBox x:Name="LogList"
                     FontFamily="Consolas" FontSize="11.5"
                     BorderThickness="0" Background="Transparent"
                     VirtualizingPanel.ScrollUnit="Pixel"/>
        </Border>

        <TextBlock x:Name="StatusText" Grid.Row="2" Margin="2,8,0,0"
                   FontSize="11.5" Foreground="{StaticResource Text.Secondary}"
                   Text="{x:Static res:Strings.Kb_Waiting}"/>
    </Grid>
</Window>
