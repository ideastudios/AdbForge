<UserControl x:Class="AdbToolkit.Views.LogcatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:AdbToolkit.Resources"
             Unloaded="View_Unloaded">

    <!-- 应用级隐式 TextBlock 样式不穿透 UserControl 模板边界，本地补一份保证文字跟随主题 -->
    <UserControl.Resources>
        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ======= 工具栏 ======= -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,12">
            <WrapPanel VerticalAlignment="Center">
                <Button x:Name="BtnStart" Content="{x:Static res:Strings.Logcat_StartCapture}"
                        Style="{StaticResource BtnAccent}"
                        Command="{Binding StartCommand}"/>
                <Button x:Name="BtnStop" Content="{x:Static res:Strings.Logcat_Stop}"
                        Margin="8,0,0,0"
                        Command="{Binding StopCommand}"/>

                <TextBlock Text="Buffer" VerticalAlignment="Center"
                           Margin="16,0,6,0" FontSize="12"
                           Foreground="{StaticResource Text.Secondary}"/>
                <ComboBox ItemsSource="{Binding Buffers}"
                          SelectedItem="{Binding SelectedBuffer}"
                          Width="90" VerticalContentAlignment="Center"/>

                <TextBlock Text="{x:Static res:Strings.Logcat_MinLevel}" VerticalAlignment="Center"
                           Margin="16,0,6,0" FontSize="12"
                           Foreground="{StaticResource Text.Secondary}"/>
                <ComboBox ItemsSource="{Binding Levels}"
                          SelectedItem="{Binding SelectedLevel}"
                          Width="60" VerticalContentAlignment="Center"/>

                <TextBlock Text="Tag" VerticalAlignment="Center"
                           Margin="16,0,6,0" FontSize="12"
                           Foreground="{StaticResource Text.Secondary}"/>
                <TextBox Text="{Binding TagFilter, UpdateSourceTrigger=PropertyChanged}"
                         Width="130"/>

                <TextBlock Text="{x:Static res:Strings.Logcat_Keyword}" VerticalAlignment="Center"
                           Margin="16,0,6,0" FontSize="12"
                           Foreground="{StaticResource Text.Secondary}"/>
                <TextBox Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}"
                         Width="160"/>

                <CheckBox Content="{x:Static res:Strings.Logcat_AutoScroll}" IsChecked="{Binding AutoScroll}"
                          VerticalAlignment="Center" Margin="16,0,0,0"/>
                <Button Content="{x:Static res:Strings.Logcat_Clear}" Margin="16,0,0,0"
                        Style="{StaticResource BtnTool}"
                        Command="{Binding ClearCommand}"/>
                <Button Content="{x:Static res:Strings.Logcat_Save}" Margin="8,0,0,0"
                        Style="{StaticResource BtnTool}"
                        Command="{Binding SaveCommand}"/>
            </WrapPanel>
        </Border>

        <!-- ======= 日志列表 ======= -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="4">
            <ListView x:Name="LogsList"
                      ItemsSource="{Binding FilteredView}"
                      ItemContainerStyle="{StaticResource LogItem}"
                      FontFamily="Consolas, Microsoft YaHei UI"
                      FontSize="12"
                      BorderThickness="0"
                      VirtualizingPanel.ScrollUnit="Pixel">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left"
                                       Text="{Binding Time}" Width="132"
                                       Foreground="{StaticResource Text.Secondary}"/>
                            <TextBlock DockPanel.Dock="Left"
                                       Text="{Binding Pid}" Width="58"
                                       Foreground="{StaticResource Text.Disabled}"/>
                            <TextBlock DockPanel.Dock="Left"
                                       Text="{Binding LevelText}" Width="24"
                                       FontWeight="Bold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource Log.I}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LevelText}" Value="V">
                                                <Setter Property="Foreground" Value="{StaticResource Log.V}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding LevelText}" Value="D">
                                                <Setter Property="Foreground" Value="{StaticResource Log.D}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding LevelText}" Value="W">
                                                <Setter Property="Foreground" Value="{StaticResource Log.W}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding LevelText}" Value="E">
                                                <Setter Property="Foreground" Value="{StaticResource Log.E}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding LevelText}" Value="F">
                                                <Setter Property="Foreground" Value="{StaticResource Log.F}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding Display}"/>
                        </DockPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <!-- ======= 状态栏 ======= -->
        <TextBlock Grid.Row="2" Text="{Binding Status}" Margin="2,8,0,0"
                   FontSize="11.5" Foreground="{StaticResource Text.Secondary}"/>
    </Grid>
</UserControl>
